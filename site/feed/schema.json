{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Follow RSI reviewed public feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "reviewed_only",
    "updated_at",
    "weeks",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "reviewed_only": {
      "const": true
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "weeks": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-W\\d{2}$"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "dates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "recaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period",
          "kind",
          "start",
          "end",
          "title_zh",
          "title_en"
        ],
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}--\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "const": "retrospective"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title_zh": {
            "type": "string"
          },
          "title_en": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "quote"
      ],
      "properties": {
        "value": {
          "enum": [
            "yes",
            "partial",
            "unknown"
          ]
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "const": "yes"
              }
            }
          },
          "then": {
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 5,
                "maxLength": 400
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "arxiv_id",
        "version",
        "title",
        "short_title",
        "authors",
        "published",
        "direction",
        "summary_zh",
        "summary_en",
        "evidence_quick",
        "evidence_notice",
        "links",
        "week",
        "review_decision",
        "repo_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "arxiv_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "short_title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "published": {
          "type": "string"
        },
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "harness_sub",
            "secondary"
          ],
          "properties": {
            "primary": {
              "enum": [
                "harness",
                "model_weights",
                "data_task",
                "ai4ai",
                "experience_world_model",
                "meta",
                "embodied",
                "evaluation_benchmark",
                "theory_survey",
                "safety_governance"
              ]
            },
            "harness_sub": {
              "enum": [
                "evolve_main",
                "generalize",
                "evidence_selection",
                "improver",
                "component",
                "coevolution",
                null
              ]
            },
            "secondary": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "summary_zh": {
          "type": "string"
        },
        "summary_en": {
          "type": "string"
        },
        "evidence_quick": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "held_out",
            "matched_budget",
            "cross_model",
            "code_released"
          ],
          "properties": {
            "held_out": {
              "$ref": "#/$defs/evidence"
            },
            "matched_budget": {
              "$ref": "#/$defs/evidence"
            },
            "cross_model": {
              "$ref": "#/$defs/evidence"
            },
            "code_released": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "evidence_notice": {
          "enum": [
            "Automated, unverified",
            "Curated evidence; see evidence card"
          ]
        },
        "source_hits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hf_upvotes": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "week": {
          "type": "string",
          "pattern": "^\\d{4}-W\\d{2}$"
        },
        "review_decision": {
          "enum": [
            "accept",
            "move",
            "backlog"
          ]
        },
        "repo_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "updated": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source version update timestamp; never an ingestion date."
        },
        "hf_daily_dates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": "Verified membership dates from fetched HF daily recommendation lists."
        },
        "daily_section": {
          "enum": [
            "hf_today",
            "other_today",
            "historical"
          ]
        },
        "edition_kind": {
          "enum": [
            "daily",
            "retrospective",
            "weekly_backlog"
          ]
        },
        "recap_period": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}--\\d{4}-\\d{2}-\\d{2}$"
        },
        "announced": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "announced_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "news_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "window_status": {
          "enum": [
            "in_window",
            "backlog",
            "stale",
            "already_published",
            null
          ]
        },
        "in_repo": {
          "type": "boolean"
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "enum": [
                "harness",
                "other_direction",
                "exclude",
                "borderline"
              ]
            },
            "improved_object_zh": {
              "type": "string"
            },
            "improved_object": {
              "type": "string"
            },
            "harness_specific": {
              "enum": [
                "yes",
                "no"
              ]
            }
          }
        }
      }
    }
  }
}
