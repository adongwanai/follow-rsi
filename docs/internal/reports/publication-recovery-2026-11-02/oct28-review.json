    {
      "id": "arxiv:2610.33245",
      "short_name": "AdaPRA",
      "hf_day": "2026-10-28",
      "recommendation": "unknown",
      "scope": "candidate_needs_review",
      "suggested_sub": "component",
      "improved_object": "in_loop_verifier",
      "reason_zh": "在线执行检查可以修改 rubric，但其版本只在单个任务的后续 attempts 保留；离线发现的 seed rubric 跨任务迁移时保持不变。不能把两阶段拼成已经验证的跨任务 Harness 自进化。",
      "reconciled_prior_judgment_zh": "2026-10-29 的定向正文复核为 borderline；2026-10-30 的独立模型为 include。来源内容未变仍不代表后者推理有效：后者将固定 workspace 持久化误写为 control-flow 修改，并把同任务 rubric 适配与离线 seed 迁移拼接。保留争议，回到 unknown/defer。",
      "feedback_driven": "yes",
      "persists_to_later_tasks": "unknown",
      "persistence_boundary_zh": "每任务 rubric store 明确隔离；离线反馈生成的 seed verifier 有跨任务适用性，但没有显示在线接受的新版本继承到独立任务。宽口径若将同任务 attempts 算后续改进轮次可能得出不同意见，不能隐藏这一口径差异。",
      "limits": [
        "固定的单任务 workspace 持久化仅证明任务状态/产物留存，不证明管理代码或控制流自己改写。",
        "离线 seed 从运行结果归纳并迁移到 DSPredict-Hard，是相关的 verifier 设计证据；不能据此声称在线 adapted rubrics 跨任务继承。",
        "旧模型理由中对 rubric 新增数有 77 与 177 的内部冲突，本次不复用该数字、不修改原论文数字。",
        "本轮只解决 scope 争议；不是全文所有实验数字和证据卡字段的审计。"
      ],
      "followup_zh": "如仍拟收录，需明确是离线 feedback-derived verifier 方法还是在线 Harness RSI，并提供被接受的新版本在独立任务复用的原文/工件。",
      "title": "AdaPRA: Process Reward Agents with Adaptive Rubrics for Data Science",
      "formal_decision": "defer",
      "suggestion_only": true,
      "human_approval_claimed": false,
