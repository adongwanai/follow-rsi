    {
      "arxiv_id": "2610.42053",
      "short_name": "REA",
      "first_submitted_at_utc": "2026-10-30T17:18:13Z",
      "recommendation": "exclude",
      "suggested_primary": "embodied",
      "suggested_section": null,
      "improved_object": "fixed_runtime_with_fitted_route_table",
      "model_frozen": "unknown",
      "persistent_harness_update": "unknown",
      "reason_zh": "建议排除当前 Harness 自进化专题。论文的核心是异步执行、预先拟合的候选路由表和固定恢复机制；开发反馈确实用于统计和路由，策略也跨 episode 复用，但没有建立 REA 自身自动修订并保留外部程序工件的闭环。",
      "loop_analysis": {
        "object_zh": "LIBERO 中候选是冻结的 Python 控制程序；按开发成功率/成本生成路由表，测试阶段查表。RoboTwin 的扩展主要是成功率预测 head。",
        "feedback_zh": "开发执行反馈用于候选排序；运行时 judge/exception 用于本 episode 的停止或切换。存在反馈，不能写成没有反馈。",
        "acceptance_zh": "路由表与恢复 ladder 评测前确定。最终 verdict 只记录；不是候选 Harness 改版的接受门。",
        "reuse_zh": "策略库和路由统计保留复用，但所核查方法没有将任务执行失败转成新的可复用路由/验证程序版本。"
      },
      "counterevidence_and_limits_zh": [
        "已核对外部 ASPIRE Fix/Evo 的程序生成/演化来源。这说明候选来源可能演化，不能据此把 REA runtime 本身认作自演化。",
        "开发统计形成持久 route memory 是正面反证；排除依据是工件修改闭环未建立，不是必须在线改进，也不是否认离线优化。",
        "RoboTwin 有 selector/head 训练，不能仅因有权重训练而排除；正文未建立外部 Harness 与权重的共同反馈迭代。",
        "固定评测框架并非天然排除，但本文主要比较具身控制和路由位置，未证明是 Harness 工件演化的专项评测。"
      ],
      "minimum_next_evidence_zh": "若后续版本或代码展示 REA 根据反馈修订长期控制流、验证器或技能文件，并在后续任务沿用，应重审；本次不据此设想补全。",
