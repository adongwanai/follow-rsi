      "id": "arxiv:2611.11499",
      "issue_url": "https://github.com/adongwanai/follow-rsi/issues/131",
      "existing_before_maintenance": true,
      "baseline_formal_review": {
        "date": "2026-11-11",
        "decision": "backlog",
