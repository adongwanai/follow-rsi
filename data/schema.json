{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Evolution paper collection",
  "type": "object",
  "required": [
    "meta",
    "papers"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "as_of",
        "sections"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "sections": {
          "type": "object",
          "required": [
            "foundations",
            "evolve_main",
            "generalize",
            "evidence_selection",
            "improver",
            "component",
            "coevolution",
            "evaluation",
            "survey_theory",
            "candidates"
          ],
          "additionalProperties": false,
          "properties": {
            "foundations": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "evolve_main": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "generalize": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "evidence_selection": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "improver": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "component": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "coevolution": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "evaluation": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "survey_theory": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "candidates": {
              "type": "object",
              "required": [
                "zh",
                "en"
              ],
              "properties": {
                "zh": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "date",
          "section"
        ],
        "anyOf": [
          {
            "required": [
              "arxiv"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "summary_zh": {
            "type": "string"
          },
          "result_zh": {
            "type": "string"
          },
          "summary_en": {
            "type": "string"
          },
          "result_en": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "weight_update": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?$"
          },
          "section": {
            "enum": [
              "foundations",
              "evolve_main",
              "generalize",
              "evidence_selection",
              "improver",
              "component",
              "coevolution",
              "evaluation",
              "survey_theory",
              "candidates"
            ]
          },
          "arxiv": {
            "type": "string",
            "pattern": "^(?:\\d{4}\\.\\d{4,5}|cs/\\d{7})$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "code": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "status": {
            "enum": [
              "candidate"
            ]
          },
          "orgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "edit_targets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "must_read": {
            "type": "boolean"
          },
          "needs_reading": {
            "type": "boolean"
          },
          "en_machine_translated": {
            "type": "boolean"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "held_out": {
                "enum": [
                  "yes",
                  "no",
                  "partial",
                  "unknown",
                  "na"
                ],
                "default": "unknown"
              },
              "matched_budget_baseline": {
                "enum": [
                  "yes",
                  "no",
                  "partial",
                  "unknown",
                  "na"
                ],
                "default": "unknown"
              },
              "cross_model_transfer": {
                "enum": [
                  "yes",
                  "no",
                  "partial",
                  "unknown",
                  "na"
                ],
                "default": "unknown"
              },
              "cost_reported": {
                "enum": [
                  "yes",
                  "no",
                  "partial",
                  "unknown",
                  "na"
                ],
                "default": "unknown"
              },
              "disjoint_evolution_set": {
                "enum": [
                  "yes",
                  "no",
                  "partial",
                  "unknown",
                  "na"
                ],
                "default": "unknown"
              },
              "reliability_metric": {
                "enum": [
                  "yes",
                  "no",
                  "partial",
                  "unknown",
                  "na"
                ],
                "default": "unknown"
              },
              "code_released": {
                "enum": [
                  "yes",
                  "no",
                  "partial",
                  "unknown",
                  "na"
                ],
                "default": "unknown"
              },
              "evolved_harness_released": {
                "enum": [
                  "yes",
                  "no",
                  "partial",
                  "unknown",
                  "na"
                ],
                "default": "unknown"
              },
              "who_edits": {
                "enum": [
                  "self",
                  "external",
                  "trained",
                  "self_human_reviewed",
                  "unknown"
                ],
                "default": "unknown"
              },
              "feedback": {
                "enum": [
                  "ground_truth",
                  "proxy",
                  "self_generated_tests",
                  "demonstrations",
                  "self_judgment",
                  "unknown"
                ],
                "default": "unknown"
              },
              "timing": {
                "enum": [
                  "offline",
                  "online",
                  "test_time",
                  "during_run",
                  "unknown"
                ],
                "default": "unknown"
              },
              "topology": {
                "enum": [
                  "chain",
                  "tree",
                  "graph",
                  "unknown"
                ],
                "default": "unknown"
              }
            }
          },
          "scope": {
            "enum": [
              "core",
              "harness_eval",
              "background",
              "general_rsi"
            ]
          },
          "needs_review": {
            "type": "boolean"
          },
          "review_suggestion_zh": {
            "type": "string"
          },
          "review_suggestion_en": {
            "type": "string"
          }
        }
      }
    }
  }
}
