550/arXiv.2604.07595, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2428626202", "name": "Matthew Penaroza"}], "abstract": null}}, {"citingPaper": {"paperId": "57563394951aebb6d7f5611808eac0ba14a5bb87", "externalIds": {"DBLP": "journals/corr/abs-2602-01869", "DOI": "10.48550/arXiv.2602.01869", "CorpusId": 289323871}, "url": "https://www.semanticscholar.org/paper/57563394951aebb6d7f5611808eac0ba14a5bb87", "title": "ProcMEM: Learning Reusable Procedural Memory from Experience via Non-Parametric PPO for LLM Agents", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2602.01869?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2602.01869, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2152055663", "name": "Qirui Mi"}, {"authorId": "2238083644", "name": "Zhi-Jian Ma"}, {"authorId": "145788064", "name": "Mengyue Yang"}, {"authorId": "2375906082", "name": "Hao-Xuan Li"}, {"authorId": "2362643495", "name": "Yi-Sen Wang"}, {"authorId": "2247479851", "name": "Hai-Feng Zhang"}, {"authorId": "2386604138", "name": "Jun Wang"}], "abstract": null}}, {"citingPaper": {"paperId": "cec30d60d01cb3f111d29a2e79628f446115695b", "externalIds": {"DBLP": "journals/corr/abs-2606-29932", "DOI": "10.48550/arXiv.2606.29932", "CorpusId": 289684215}, "url": "https://www.semanticscholar.org/paper/cec30d60d01cb3f111d29a2e79628f446115695b", "title": "SAGA: Scene-Aware, Goal-Evolving Agents for Long-Horizon CivRealm Strategy Planning", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2606.29932?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2606.29932, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2407486989", "name": "Tian Jin"}, {"authorId": "2445709601", "name": "Shuo Chen"}, {"authorId": "2296947641", "name": "Yida Wang"}, {"authorId": "2273686727", "name": "Liu-Yu Xiang"}, {"authorId": "2344580811", "name": "Ying-Zhuo Liu"}, {"authorId": "2445722151", "name": "Zhiyao Jiang"}, {"authorId": "2280099936", "name": "Ye-Xin Li"}, {"authorId": "2303276150", "name": "Zhao-Feng He"}], "abstract": null}}, {"citingPaper": {"paperId": "3bbf8cb2f21076c0008876934bccb8e798a54028", "externalIds": {"DBLP": "journals/corr/abs-2607-15218", "DOI": "10.48550/arXiv.2607.15218", "CorpusId": 290217001}, "url": "https://www.semanticscholar.org/paper/3bbf8cb2f21076c0008876934bccb8e798a54028", "title": "When Words Are Safe But Actions Kill: Probing Physical Danger Beyond Text Safety in Hidden-State Risk Space", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2607.15218?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2607.15218, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2450389499", "name": "Weimeng Wang"}, {"authorId": "96309523", "name": "Zi-Qiang Wang"}, {"authorId": "2409932786", "name": "Zi-Hang Zhan"}, {"authorId": "2084647583", "name": "Chuan-Pu Fu"}, {"authorId": "2312343187", "name": "Qi Li"}, {"authorId": "2312401769", "name": "Ke Xu"}], "abstract": null}}, {"citingPaper": {"paperId": "47321d694d4a204d3bced9dab2e8162bddf08881", "externalIds": {"DBLP": "journals/access/ZamilJ26", "DOI": "10.1109/ACCESS.2026.3711683", "CorpusId": 290070016}, "url": "https://www.semanticscholar.org/paper/47321d694d4a204d3bced9dab2e8162bddf08881", "title": "Esiur: A Resource-Centric Distributed Runtime Framework for Real-Time State Synchronization", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2026.3711683", "status": "GOLD", "license": "CCBYNCND", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2026.3711683?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2026.3711683, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2399092996", "name": "Ahmed Kh. Zamil"}, {"authorId": "21156806", "name": "Ammar D. Jasim"}], "abstract": "Modern distributed applications operate across heterogeneous cloud, edge, and cyber-physical environments where maintaining object identity, synchronizing state, and enabling real-time interaction remain challenging. Existing communication frameworks are mainly message-centric and treat application state as serialized payloads, which increases overhead when objects are continuously observed, incrementally updated, or shared across multiple nodes. This paper presents Esiur, a resource-centric distributed runtime that provides reference-based interaction through network-transparent resources exposing properties, events, and functions. Esiur preserves object identity across nodes and performs incremental state synchronization without application-level coordination. It defines a unified binary protocol based on the Type Representation Unit (TRU) and Transfer Data Unit (TDU), enabling runtime type definition (TypeDef) discovery and efficient transmission of strongly typed and heterogeneous data without external schemas. The framework is evaluated through serialization benchmarks, protocol-overhead measurements, ordered-notification analysis, annotation-guided invocation, subscriber and attachment scalability tests, and cross-language reattachment recovery between C# and TypeScript implementations. Results show a 36.4%\u201368.7% reduction in serialization size relative to JavaScript Object Notation (JSON), statistically bounded notification latency, successful runtime TypeDef-based invocation, final-state convergence after transient wide-area network (WAN) disconnection, and stable behavior under concurrent subscriber and attachment loads."}}, {"citingPaper": {"paperId": "6d95442bdc8ce15e312a1c365d0e93e2b7fbb942", "externalIds": {"DBLP": "journals/tccn/LiuLJLY26", "DOI": "10.1109/TCCN.2026.3710519", "CorpusId": 289969199}, "url": "https://www.semanticscholar.org/paper/6d95442bdc8ce15e312a1c365d0e93e2b7fbb942", "title": "Multi-UAV Trajectory Planning for Dynamic Target Search: An LLM-Enhanced Multi-Agent Reinforcement Learning Algorithm", "openAccessPdf": {"url": "https://doi.org/10.1109/tccn.2026.3710519", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/TCCN.2026.3710519?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/TCCN.2026.3710519, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2315449362", "name": "Yifei Liu"}, {"authorId": "2139520388", "name": "Xiao-Shuai Li"}, {"authorId": "2139348633", "name": "Xiao-Ping Jiang"}, {"authorId": "2309700094", "name": "Hui Liu"}, {"authorId": "2144527879", "name": "Ju-Nan Yang"}], "abstract": "Deploying Uncrewed Aerial Vehicles (UAVs) for dynamic target search in disaster response scenarios can reduce losses. This paper investigates multi-UAV cooperative trajectory planning for dynamic target search in a three-dimensional environment with static obstacles, aiming to maximize the number of searched targets and minimize the average uncertainty of the search area, while ensuring collision avoidance between UAVs and obstacles. Existing Multi-Agent Reinforcement Learning (MARL) based methods face the sparse reward problem in dynamic target search, which hinders planning feasible multi-UAV trajectories. Notably, Large Language Models (LLMs), with extensive pre-trained knowledge and powerful semantic reasoning capabilities, exhibit potential for designing high-quality reward functions to alleviate the sparse reward problem. Therefore, we propose an LLM-guided Multi-Agent Proximal Policy Optimization (LLM-MAPPO) algorithm, which leverages LLMs\u2019 reasoning capabilities to guide MARL policy learning and plans multi-UAV trajectories for efficient dynamic target search. Specifically, we design an offline LLM reward shaping scheme that generates dense reward signals to mitigate the sparse reward problem. Moreover, we propose a dual-mode pheromone-based search mechanism to guide UAVs to respond promptly to changes in target positions. Experimental results demonstrate that LLM-MAPPO significantly outperforms compared algorithms in terms of the number of searched targets and average area uncertainty, while successfully avoiding collisions. In particular, LLM-MAPPO reduces the target search time by 71.4%."}}, {"citingPaper": {"paperId": "8a3ae8ce3ad01d306445842b42146475e6c128f9", "externalIds": {"DBLP": "journals/access/MoZZGR26", "DOI": "10.1109/ACCESS.2026.3713401", "CorpusId": 290193066}, "url": "https://www.semanticscholar.org/paper/8a3ae8ce3ad01d306445842b42146475e6c128f9", "title": "Self-Evolving AI Agents With Dual Memory for Automated Software Testing and Bug Localization", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2026.3713401", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2026.3713401?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2026.3713401, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2450079781", "name": "Tian-Jun Mo"}, {"authorId": "2445482361", "name": "Chang-Hao Zhang"}, {"authorId": "2400502922", "name": "Ji-Tong Zou"}, {"authorId": "2359601487", "name": "Zi-Xuan Guo"}, {"authorId": "2443179312", "name": "Minjae Rhee"}], "abstract": "Large Language Model (LLM)-based autonomous agents have shown significant promise in automating software engineering tasks, yet existing systems still suffer from two fundamental limitations: i) the lack of persistent experiential knowledge across debugging sessions, which forces agents to repeat exploratory mistakes, and ii) the static nature of prompt structures, which prevents agents from adapting their reasoning strategy to recurring failure modes. To address these gaps, we propose LS-CM (Long-Short Collaborative Memory), a dual-memory architecture that couples a Retrieval-Augmented Generation (RAG)-based short-term memory for code-base context with a Reinforcement Learning (RL)-driven long-term memory that distills strategic patterns from historical test failures and patch iterations. The core innovation is a self-evolving context engineering module that automatically refines the agent\u2019s internal prompt structure based on execution feedback signals, treating the prompt as a configurable policy object that a gradient-free controller selects among pre-generated variants, rather than a fixed artifact. We evaluate LS-CM on two industry-standard benchmarks: SWE-bench, for end-to-end issue resolution on real-world GitHub repositories, and Defects4J, for bug localization and program repair in Java projects. Across multiple LLM backbones, LS-CM resolves 33.7% of SWE-bench Lite issues, a modest gain over the strongest reproduced baseline (Agentless, 32.0%), and improves Top-1 fault localization accuracy on Defects4J from 42.6% to 47.6% while reducing editing churn by 31%. We find that LS-CM\u2019s most robust advantages lie in debugging efficiency, cross-episode strategy transfer, and run-to-run stability rather than in a single headline resolved-rate number. Ablation studies confirm that short-term retrieval, long-term policy learning, and self-evolving prompts each contribute to the gains. Our work demonstrates that explicitly modeling memory and prompt adaptation as first-class learning objects substantially enhances agent productivity on real-world software engineering tasks."}}, {"citingPaper": {"paperId": "56eaa0414651fa084f3af25432374fc2c52ec763", "externalIds": {"DBLP": "journals/corr/abs-2608-05446", "DOI": "10.48550/arXiv.2608.05446", "CorpusId": 290852036}, "url": "https://www.semanticscholar.org/paper/56eaa0414651fa084f3af25432374fc2c52ec763", "title": "EvoHarness-RL: Learning Self-Evolving Runtime Harness for Long-Horizon LLM Agents", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2608.05446?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2608.05446, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2266396687", "name": "Xu-Ying Ning"}, {"authorId": "2324009031", "name": "Dong-Qi Fu"}, {"authorId": "2319175383", "name": "Tian-Xin Wei"}, {"authorId": "2324910963", "name": "Han-Qing Zeng"}, {"authorId": "2155460174", "name": "Yuan-Chen Bei"}, {"authorId": "2405896518", "name": "Bing-Xuan Li"}, {"authorId": "2294786726", "name": "Zihao Li"}, {"authorId": "2260433198", "name": "Qi-Fan Wang"}, {"authorId": "2373454576", "name": "Xiang Shen"}, {"authorId": "2328023239", "name": "Yi-Fan Wu"}, {"authorId": "2286338976", "name": "Jia-Yi Liu"}, {"authorId": "2361779372", "name": "Hong Li"}, {"authorId": "2258547648", "name": "Ying-Long Xia"}, {"authorId": "2323788930", "name": "Xiang-Jun Fan"}, {"authorId": "2359204202", "name": "Hang-Hang Tong"}, {"authorId": "2303885774", "name": "Jing-Rui He"}], "abstract": null}}, {"citingPaper": {"paperId": "6716ce92e70ab1c8f12cc5570b3637d4d3bfaf3a", "externalIds": {"DBLP": "journals/access/VatsalDB26", "DOI": "10.1109/ACCESS.2026.3720396", "CorpusId": 290916506}, "url": "https://www.semanticscholar.org/paper/6716ce92e70ab1c8f12cc5570b3637d4d3bfaf3a", "title": "Beyond Static Agents: A Six-Dimensional Taxonomy and Survey of Self-Evolving LLM Agents for Healthcare", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2026.3720396", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2026.3720396?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2026.3720396, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "1491705917", "name": "Shubham Vatsal"}, {"authorId": "2311890970", "name": "Harsh Dubey"}, {"authorId": "21204259", "name": "Ahsaas Bajaj"}], "abstract": "Large language model (LLM)-based agents are increasingly being explored for healthcare tasks such as clinical decision support, care coordination and autonomous workflow execution. Beyond static pipelines, recent systems claim to self-evolve by adapting their tools, memory, reasoning, policy, context and coordination strategies over time. However, what constitutes true self-evolution in healthcare agents remains unclear and is inconsistently evaluated. In this work, we introduce a six-dimensional taxonomy to rigorously characterize self-evolving LLM agents in healthcare, comprising Tools & Capabilities, Memory & Knowledge, Context & Prompt, Policy & Strategy, Multi-Agent Coordination and Reasoning. Using this taxonomy, we systematically evaluate 18 representative healthcare agent papers under strict mechanism-level criteria that separate genuine self-evolution from surface-level performance improvements. Our results reveal that memory evolution is the most common capability with over half of the surveyed systems exhibiting reflective or distilled memory growth, while only 5.6% demonstrates memory refactoring. In contrast, prompt self-revision appears in 33.3% of the papers and tool-selection evolution appears in only 5.6%. Multi-agent architectures (i.e., systems with multiple interacting agent roles/modules) are frequent, yet learned coordination remains limited, with only 16.7% exhibiting evolving protocols or topologies. We find no evidence of formal policy optimization or reasoning-mechanism evolution across these 18 papers. Overall, our analysis shows a clear gap between claimed adaptivity and verifiable self-evolution in current healthcare agents. This taxonomy provides a principled foundation for evaluating future self-evolving LLM systems and supports more rigorous, reproducible progress toward adaptive clinical AI."}}, {"citingPaper": {"paperId": "a7897952c642ba622f89369f748d219f4e773b92", "externalIds": {"DBLP": "conf/gecoin/GherghescuMY26", "CorpusId": 291146855}, "url": "https://www.semanticscholar.org/paper/a7897952c642ba622f89369f748d219f4e773b92", "title": "Agent Harnesses for GPU Kernel Optimization: A Taxonomy of Failure Modes and Design Implications", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2311881045", "name": "Alexandru M. Gherghescu"}, {"authorId": "2457825424", "name": "William Martin"}, {"authorId": "2294362068", "name": "Rio Yokota"}], "abstract": null}}, {"citingPaper": {"paperId": "76e2f530196c30b9493e466601d96c736700a3b3", "externalIds": {"DBLP": "journals/tnse/PengJLYZ26", "DOI": "10.1109/TNSE.2026.3720648", "CorpusId": 290901476}, "url": "https://www.semanticscholar.org/paper/76e2f530196c30b9493e466601d96c736700a3b3", "title": "Privacy-Preserving Agentic AI in Edge Networks With Content and Trace Protection", "openAccessPdf": {"url": "https://doi.org/10.1109/tnse.2026.3720648", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/TNSE.2026.3720648?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/TNSE.2026.3720648, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2457902191", "name": "Sheng-Hui Peng"}, {"authorId": "2456267767", "name": "Yuan Jiang"}, {"authorId": "2353208509", "name": "Yi-Wei Liu"}, {"authorId": "2191604417", "name": "Xin-Lei Yu"}, {"authorId": "1692039", "name": "Lie-Huang Zhu"}], "abstract": "Agentic Artificial Intelligence (AI) enables task execution by coordinating calls to service agents, which makes it attractive for edge services under diverse user requests in edge networks. However, this workflow introduces new privacy risks. First, transmitted call messages may expose sensitive content through explicit fields and values. Second, the observable calling sequence over the network may reveal user intent through the selection and ordering of called service agents. Existing edge agentic AI methods mainly improve efficiency through multi-agent coordination, model compression, or cloud offloading, while privacy defenses are still limited and often focus on input filtering, interface masking, or action constraints. To address these issues, we propose a two-layer privacy-preserving agentic framework with a device controller agent and a service agent pool. The device agent integrates three privacy modules: (i) The disclosure control module marks each field value pair as \u201ckeep\u201d, \u201chide\u201d, or \u201cdrop\u201d to limit plaintext exposure. (ii) The variational information bottleneck encoding module replaces \u201chide\u201d values with protected semantic hints to preserve utility. (iii) The decoy insertion module adds safe decoy calls under a per-subtask budget to reduce trace leakage. Experiments across diverse tasks and settings show that the proposed framework reduces both content leakage and trace leakage while maintaining task utility."}}, {"citingPaper": {"paperId": "d17b4308515dc02975e915f554f8ad3fd46d6be4", "externalIds": {"DBLP": "journals/corr/abs-2605-22148", "DOI": "10.48550/arXiv.2605.22148", "CorpusId": 291742528}, "url": "https://www.semanticscholar.org/paper/d17b4308515dc02975e915f554f8ad3fd46d6be4", "title": "Ratchet: A Minimal Hygiene Recipe for Self-Evolving LLM Agents", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2605.22148?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2605.22148, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "102356716", "name": "Xing Zhang"}, {"authorId": "2309116797", "name": "Ya Cui"}, {"authorId": "2420203852", "name": "Guang-Hui Wang"}, {"authorId": "2224621614", "name": "Zi-Yuan Li"}, {"authorId": "152525244", "name": "Wei Qiu"}, {"authorId": "2224666655", "name": "Bing Zhu"}, {"authorId": "2299517857", "name": "Pei-Gen He"}], "abstract": null}}, {"citingPaper": {"paperId": "b35cd1058f7614a282f5932c1f9e39e9f25f595a", "externalIds": {"DBLP": "journals/access/JangLK26a", "DOI": "10.1109/ACCESS.2026.3730445", "CorpusId": 291804650}, "url": "https://www.semanticscholar.org/paper/b35cd1058f7614a282f5932c1f9e39e9f25f595a", "title": "Coverage-Aware Guidance for Novelty-Driven Exploration in Automated Game Testing Under Sparse-Reward 3-D Environments", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2026.3730445", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2026.3730445?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2026.3730445, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2375232662", "name": "Tae-Hyeon Jang"}, {"authorId": "2447333924", "name": "Hyeon-Uk Lee"}, {"authorId": "2118020583", "name": "Hyunseok Kim"}], "abstract": "Automated testing of high-fidelity 3D games requires agents to explore large state spaces under sparse rewards and execute context-dependent interactions that expose faults. Random network distillation (RND) promotes exploration by rewarding observations that remain difficult for a predictor network to estimate, but prediction error does not explicitly represent exercised state-action contexts. We propose RND+CAE, which combines RND with coverage-guided adaptive exploration (CAE). CAE maintains visitation counts over environment-adapted coverage abstractions and provides a one-step recovery bonus when structured coverage stops expanding. We evaluate the framework in a randomized maze for spatial exploration and a partitioned arena for interaction-dependent fault discovery. RND remains a strong maze baseline, while RND+CAE achieves comparable cumulative coverage with lower observed variability. In the Arena, RND+CAE obtains the highest mean final unique bug count and bug-discovery area under the curve (AUC) among the main methods. An ablation shows that spatial-only guidance matches Full RND+CAE in final fault breadth but accumulates faults more slowly, whereas removing stagnation recovery reduces bug AUC and the proportion of runs reaching five bugs. These results indicate that geometric coverage strongly influences eventual fault breadth in the fixed Arena and that Full CAE\u2019s clearest additional contribution is sustained late-stage discovery through stagnation recovery. The independent benefits of interaction-oriented keys are not established consistently. The framework may also support reliability validation in complex disaster-response simulations."}}, {"citingPaper": {"paperId": "e5469da2391a583b79726cf3971077b1e02319a8", "externalIds": {"DBLP": "journals/comsur/SeonLKSSBKK26", "DOI": "10.1109/COMST.2026.3735868", "CorpusId": 292310550}, "url": "https://www.semanticscholar.org/paper/e5469da2391a583b79726cf3971077b1e02319a8", "title": "Agentic Semantic Communication: Concepts, Architectures, and Visions", "openAccessPdf": {"url": "https://doi.org/10.1109/comst.2026.3735868", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/COMST.2026.3735868?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/COMST.2026.3735868, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2134933108", "name": "Joonho Seon"}, {"authorId": "83320371", "name": "Seongwoo Lee"}, {"authorId": "46877337", "name": "Soohyun Kim"}, {"authorId": "2324503519", "name": "Youngghyu Sun"}, {"authorId": "50821478", "name": "Hyowoon Seo"}, {"authorId": "1702172", "name": "M. Bennis"}, {"authorId": "2261731496", "name": "Dong In Kim"}, {"authorId": "2184070307", "name": "Jin Young Kim"}], "abstract": "Sixth-generation (6G) applications are increasingly requiring receivers to execute tasks based on received information. However, existing approaches optimize bit-level reconstruction independently of task relevance, so scarce transmission resources can be spent on task-irrelevant information, making the resulting data rate requirements increasingly difficult to meet. This discrepancy between the purpose of communication and the objective being optimized has led to a paradigm shift toward semantic communication (SC). Although prior surveys have examined SC, autonomous SC systems capable of adaptability and reasoning remain insufficiently explored. To address this research gap, we present a concept of Agentic SC (ASC) which emphasizes autonomy by enabling agents in communication systems to dynamically perceive, plan, reason, and self-correct in response to tasks and environmental changes. In this survey, we establish the conceptual foundation of ASC and propose a new taxonomy of SC based on the degree of system-level integration. Within this taxonomy, we review existing studies, highlight representative techniques, and draw lessons across different lines of work. Specifically, we explore how agents based on large-scale language models, world models, external knowledge, orchestration, and emergent communication can achieve autonomy and adaptability. In addition, we investigate collaborative communication and coordination strategies, as well as edge deployment techniques that enable ASC systems to operate at scale. Furthermore, we identify promising applications and use cases for ASC, identify open challenges for system implementation, and suggest future research directions."}}, {"citingPaper": {"paperId": "8f371e6582e761968b1aae261fbaeefa46778d5d", "externalIds": {"DBLP": "journals/access/MumcuBJCY26", "DOI": "10.1109/ACCESS.2026.3737989", "CorpusId": 292447547}, "url": "https://www.semanticscholar.org/paper/8f371e6582e761968b1aae261fbaeefa46778d5d", "title": "Language Models in Video Anomaly Detection: A Dynamic Survey", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2026.3737989", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2026.3737989?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2026.3737989, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2161662354", "name": "Furkan Mumcu"}, {"authorId": "2408647878", "name": "Lokman Bekit"}, {"authorId": "2111328101", "name": "Michael J. Jones"}, {"authorId": "2691929", "name": "A. Cherian"}, {"authorId": "79595155", "name": "Yasin Y\u0131lmaz"}], "abstract": "Video Anomaly Detection (VAD) plays a critical role in intelligent surveillance and public safety by identifying rare, unexpected, or contextually abnormal events in complex video environments. Conventional deep learning approaches have substantially advanced VAD, but they remain largely driven by visual representations and often face challenges in semantic generalization, interpretability, and adaptation to unseen anomaly types. Recent Large Language Models (LLMs) and Multimodal Large Language Models (MLLMs) are reshaping the field by enabling semantic reasoning, contextual understanding, language-guided detection, open-vocabulary recognition, and natural-language explanation. This survey provides a focused and systematic review of language-model-based VAD. We organize existing methods across major supervision and deployment paradigms, including fully supervised, unsupervised, semi-supervised, weakly supervised, training-free, instruction-tuned, and open-world/open-vocabulary VAD, while positioning them relative to key non-language-model foundations. We further review representative datasets and evaluation protocols, emphasizing their suitability and limitations for both anomaly detection and anomaly understanding. Beyond serving as a static snapshot of the literature, this paper is designed as a dynamic survey whose taxonomy, method coverage, datasets, and evaluation discussion can be maintained through versioned updates as new work emerges. This evolving resource is supported by the public website dynamicvadsurvey.github.io, which provides access to maintained releases, archived versions, update records, and interactive exploration of the surveyed literature."}}, {"citingPaper": {"paperId": "c67c75fb2eb10f06b66c19d6e84b571e5ab8c039", "externalIds": {"DOI": "10.1109/TON.2026.3740426", "CorpusId": 292713054}, "url": "https://www.semanticscholar.org/paper/c67c75fb2eb10f06b66c19d6e84b571e5ab8c039", "title": "PE-IoA: Parameter-Efficient Co-Evolutionary Learning in Internet of Agents", "openAccessPdf": {"url": "https://doi.org/10.1109/ton.2026.3740426", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/TON.2026.3740426?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/TON.2026.3740426, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": null, "publicationDate": null, "authors": [{"authorId": "2367189578", "name": "Ying-Fan Deng"}, {"authorId": "2367047934", "name": "An-Hao Zhou"}, {"authorId": "2280045645", "name": "Yuan Yuan"}, {"authorId": "2115477909", "name": "Xiao Zhang"}, {"authorId": "23159213", "name": "Yi-Fei Zou"}, {"authorId": "2239137290", "name": "Dong-Xiao Yu"}], "abstract": "Internet of Agents (IoA) have recently emerged as a promising paradigm for collaborative reasoning and solving complex tasks. However, the deployment of large language models (LLMs) in IoA settings poses new challenges, including prohibitive communication overhead, high computational cost, and insufficient agent-level personalization. To address these issues, we propose PE-IoA (Parameter-Efficient Co-Evolutionary Learning in Internet of Agents), a novel collaboration learning framework that supports efficient, scalable, and personalized co-evolution in Internet of Agents. In PE-IoA, each agent maintains a lightweight personalized adapter to support agent-specific behavior, while a shared adapter is collaboratively optimized across neighboring agents. This parameter-efficient design balances global coordination with local adaptation under heterogeneous environments and makes PE-IoA particularly suitable for large-scale backbones. We theoretically prove that PE-IoA achieves an asymptotically optimal convergence rate of <inline-formula> <tex-math notation=\"LaTeX\">$\\mathcal {O}\\left ({ \\frac {1}{\\sqrt {NT}}}\\right)$ </tex-math></inline-formula>, where <inline-formula> <tex-math notation=\"LaTeX\">$N$ </tex-math></inline-formula> is the number of agents and <inline-formula> <tex-math notation=\"LaTeX\">$T$ </tex-math></inline-formula> the global maximum number of iterations. Extensive experiments with ViT show that PE-IoA can maintain accuracy fluctuations within 2%, and is 1%\u20134% higher than full model, while reducing training and communication costs by 97% and 98%, respectively."}}, {"citingPaper": {"paperId": "3ad018918017d9e8171d6ec111f31a87f9763d9e", "externalIds": {"DBLP": "conf/iclr/ZhaoSZGLMZLZC26", "DOI": "10.48550/arXiv.2512.10534", "CorpusId": 295404589}, "url": "https://www.semanticscholar.org/paper/3ad018918017d9e8171d6ec111f31a87f9763d9e", "title": "Achieving Olympia-Level Geometry Large Language Model Agent via Complexity Boosting Reinforcement Learning", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2512.10534?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2512.10534, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2376280951", "name": "Hai-Teng Zhao"}, {"authorId": "2376233066", "name": "Jun-Hao Shen"}, {"authorId": "2348882213", "name": "Yi-Ming Zhang"}, {"authorId": "2335827751", "name": "Song-Yang Gao"}, {"authorId": "2029335061", "name": "Kui-Kun Liu"}, {"authorId": "2400506195", "name": "Tian-You Ma"}, {"authorId": "2399084354", "name": "Fan Zheng"}, {"authorId": "2261095726", "name": "Da-Hua Lin"}, {"authorId": "2266359401", "name": "Wen-Wei Zhang"}, {"authorId": "2371440263", "name": "Kai Chen"}], "abstract": null}}, {"citingPaper": {"paperId": "00cd7365ed858affbf1971c9f65466aa947cfb56", "externalIds": {"DBLP": "journals/corr/abs-2602-02711", "DOI": "10.48550/arXiv.2602.02711", "CorpusId": 295411965}, "url": "https://www.semanticscholar.org/paper/00cd7365ed858affbf1971c9f65466aa947cfb56", "title": "Dynamic Mix Precision Routing for Efficient Multi-step LLM Interaction", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2602.02711?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2602.02711, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2392211577", "name": "Yuan-Zhe Li"}, {"authorId": "2375768915", "name": "Jia-Ning Deng"}, {"authorId": "2328473437", "name": "Jing-Tong Hu"}, {"authorId": "2335843178", "name": "Tian-Long Chen"}, {"authorId": "2355876312", "name": "Song Wang"}, {"authorId": "2334663584", "name": "Huan-Rui Yang"}], "abstract": null}}, {"citingPaper": {"paperId": "e3511655d0da6593b866360846a660458e83d761", "externalIds": {"DOI": "10.1109/ACCESS.2026.3747680", "CorpusId": 294672334}, "url": "https://www.semanticscholar.org/paper/e3511655d0da6593b866360846a660458e83d761", "title": "S\u00b3-Agent: Causal and Contract-Checked Scheduling for Abstract GPU Partitioning", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2026.3747680", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2026.3747680?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2026.3747680, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": null, "publicationDate": null, "authors": [{"authorId": "2476400999", "name": "Jia-Xuan Lin"}, {"authorId": "2521292146", "name": "Zheng-Rong Yi"}], "abstract": "We evaluate S3-Agent as a causal, contract-checked interface for abstract GPU partitioning. Online policies choose among three layouts of a four-unit simulated resource using arrived jobs. A stateful executor checks allocation, drained reconfiguration, and completion, committing simulator state only after validation. Across 20 independent seeds and six workload cells, queue-fit scheduling reduced the mean profile-fit gap from 0.393 to 0.217. Its mean completion-time difference from a fixed layout was \u22120.89 simulated seconds (95% confidence interval \u22122.27 to 0.49), which does not resolve an improvement. A separate 12-seed sequential study connects diagnostic output to a later Qwen2.5-1.5B-Instruct planner, with optional read-only retrieval. The current CPU repeat made 188 model calls in 60 simulated runs and charged measured callback time as scheduler delay. The complete path averaged 29.88 simulated seconds versus 23.71 for queue-fit; its paired difference was + 6.17 s (95% paired interval + 2.90 to + 9.45). Diagnostic labels agreed with the declared queue-count reference in 18/62 calls. Earlier controlled and neutral-prompt diagnosis failures are retained. These studies do not establish the necessity of all three proposed modules. A separate simulation uses published CERN particle-job runtimes as service-time inputs. Safety results assume atomic, single-threaded simulated transitions; physical MIG scheduling and rollback remain unmeasured."}}, {"citingPaper": {"paperId": "981defb06fcd57c0c5c134c3e9dc0f9385af0c30", "externalIds": {"DBLP": "journals/corr/abs-2604-07799", "DOI": "10.48550/arXiv.2604.07799", "CorpusId": 295644545}, "url": "https://www.semanticscholar.org/paper/981defb06fcd57c0c5c134c3e9dc0f9385af0c30", "title": "Learning Without Losing Identity: Capability Evolution for Embodied Agents", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2604.07799?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2604.07799, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2258307310", "name": "Xue Qin"}, {"authorId": "2093554061", "name": "Si-Min Luan"}, {"authorId": "2376267717", "name": "John See"}, {"authorId": "2277804732", "name": "Cong Yang"}, {"authorId": "2197467602", "name": "Zhi-Jun Li"}], "abstract": null}}, {"citingPaper": {"paperId": "f50388d0dacd5b0fac547bfa77c15dc8efcdb0c0", "externalIds": {"DBLP": "journals/corr/abs-2609-20822", "DOI": "10.48550/arXiv.2609.20822", "CorpusId": 295647200}, "url": "https://www.semanticscholar.org/paper/f50388d0dacd5b0fac547bfa77c15dc8efcdb0c0", "title": "Coding Agents with an Obstacle-Aware Harness for Safe Robot Manipulation", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2609.20822?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2609.20822, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2293281293", "name": "Bing-Xin Xu"}, {"authorId": "2380471827", "name": "Yu-Zhang Shang"}, {"authorId": "2486703280", "name": "Zhen-Han Dong"}, {"authorId": "48898287", "name": "Emilio Ferrara"}], "abstract": null}}, {"citingPaper": {"paperId": "27c9ab0827bbfbed9d444df665d441f663943801", "externalIds": {"DBLP": "journals/corr/abs-2604-26689", "DOI": "10.48550/arXiv.2604.26689", "CorpusId": 295653618}, "url": "https://www.semanticscholar.org/paper/27c9ab0827bbfbed9d444df665d441f663943801", "title": "Atomic-Probe Governance for Skill Updates in Compositional Robot Policies", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2604.26689?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2604.26689, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2258307310", "name": "Xue Qin"}, {"authorId": "2093554061", "name": "Si-Min Luan"}, {"authorId": "2376267717", "name": "John See"}, {"authorId": "2277804732", "name": "Cong Yang"}, {"authorId": "2197467602", "name": "Zhi-Jun Li"}], "abstract": null}}, {"citingPaper": {"paperId": "2dce652160e3a10cf242d9c15628091f4477794a", "externalIds": {"DBLP": "journals/corr/abs-2604-17886", "DOI": "10.48550/arXiv.2604.17886", "CorpusId": 295653728}, "url": "https://www.semanticscholar.org/paper/2dce652160e3a10cf242d9c15628091f4477794a", "title": "Latent Preference Modeling for Cross-Session Personalized Tool Calling", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2604.17886?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2604.17886, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2293614970", "name": "Yejin Yoon"}, {"authorId": "2375560917", "name": "Minseo Kim"}, {"authorId": "2375750526", "name": "Taeuk Kim"}], "abstract": null}}, {"citingPaper": {"paperId": "6638b2dffde9cb4b4d37bdbe5b6d452a138b2a02", "externalIds": {"DOI": "10.14569/ijacsa.2026.0171024", "CorpusId": 295614160}, "url": "https://www.semanticscholar.org/paper/6638b2dffde9cb4b4d37bdbe5b6d452a138b2a02", "title": "LLM-Assisted Offline Reward Design for Reinforcement Learning-Based Irrigation Scheduling", "openAccessPdf": {"url": "https://doi.org/10.14569/ijacsa.2026.0171024", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.14569/ijacsa.2026.0171024?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.14569/ijacsa.2026.0171024, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": null, "publicationDate": null, "authors": [{"authorId": "2407670877", "name": "Qiu-Fen Wang"}, {"authorId": "2409306898", "name": "Tian-Hao Wang"}, {"authorId": "2527042825", "name": "Zi-Yue Wang"}], "abstract": "This study develops an LLM-assisted offline workflow for reward design in reinforcement learning-based irrigation scheduling under a seasonal water allocation. Researchers provide agronomic knowledge and feedback on candidate-policy behavior, and the language model translates these inputs into executable rewards. Eight candidates are compared over four generations. The selected reward, aridity\u2013soil curriculum, and FAO-56 exploration mask are held fixed during final policy training and transfer evaluation. Across 24 transfer scenarios comprising two withheld sites, three soil textures and four seasons, proximal policy optimization achieves a mean net benefit of 1943 USD ha\u207b\u00b9, 2.8 per cent above the strictest tuned rule and 9.1 per cent above the untuned FAO-56 rule. The paired mean gain is 52.5 USD ha\u207b\u00b9, with site means of +127.9 at Lubbock and \u221223.0 at Urbana. Grouping shared-weather outcomes into eight site\u2013season blocks gives a two-sided sign-flip p-value of 0.117; joint resampling of sites, seasons, and training seeds gives an exploratory percentile range of \u221243.3 to 159.6 USD ha\u207b\u00b9. The combined curriculum and exploration mask increase convergence frequency from 5/10 to 10/10 runs in the evaluated ablation. The results connect offline reward design with stage-sensitive water allocation and show how its scheduling value varies between semi-arid and humid conditions."}}, {"citingPaper": {"paperId": "82f2c012358d4734c4e134ae6a3e1054bf1baa0a", "externalIds": {"DOI": "10.18653/2026.aacl-long.169", "CorpusId": 295755555}, "url": "https://www.semanticscholar.org/paper/82f2c012358d4734c4e134ae6a3e1054bf1baa0a", "title": "Llm agent memory: a survey from a unified representation\u2013management perspective", "openAccessPdf": {"url": "https://aclanthology.org/2026.aacl-long.169.pdf", "status": "BRONZE", "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.18653/2026.aacl-long.169?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.18653/2026.aacl-long.169, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": null, "publicationDate": null, "authors": [{"authorId": "66873962", "name": "Zhen-Heng Tang"}, {"authorId": "2526362389", "name": "Xin He"}, {"authorId": "2530368252", "name": "Tian-Cheng Zhao"}, {"authorId": "2457015304", "name": "Fan Wei"}, {"authorId": "2265743820", "name": "Xiang Liu"}, {"authorId": "2265581222", "name": "Pei-Jie Dong"}, {"authorId": "2311494327", "name": "Qian Wang"}, {"authorId": "2437958052", "name": "Qi Li"}, {"authorId": "2381682731", "name": "Hua-Can Wang"}, {"authorId": "2380327215", "name": "Rong-Hao Chen"}, {"authorId": "2363887804", "name": "Sen Hu"}, {"authorId": "2291093766", "name": "Wei-Dong Guo"}, {"authorId": "2276484210", "name": "Yu Xu"}, {"authorId": "2019329", "name": "Hao-Lan Chen"}, {"authorId": "2710113", "name": "Kun-Feng Lai"}, {"authorId": "2047645", "name": "Kai-Yong Zhao"}, {"authorId": "2254282405", "name": "Ke-Yan Ding"}, {"authorId": "1807998", "name": "I. Tsang"}, {"authorId": "122155291", "name": "Yew-Soon Ong"}, {"authorId": "2343704731", "name": "Bo Li"}, {"authorId": "2259315629", "name": "Xiao-Wen Chu"}], "abstract": "Large language models (LLMs) face significant challenges in sustaining long-term memory for agentic applications due to limited context windows. To address this limitation, many work has proposed diverse memory mechanisms to support long-term, multi-turn interactions, leveraging different approaches tailored to distinct memory storage objects, such as KV caches. In this survey, we present a unified taxonomy that organizes memory systems for long-context scenarios by decoupling memory abstractions from model-specific inference and training methods. We categorize LLM memory into three primary paradigms: natural language tokens, intermediate representations and parameters. For each paradigm, we organize existing methods by three management stages, including memory construction, update, and query, so that long-context memory mechanisms can be described in a consistent way across system designs, with their implementation choices and constraints made explicit. Finally, we outline key research directions for long-context memory system design."}}, {"citingPaper": {"paperId": "1f87b1912fae41349875c567ca5465a6d51498b1", "externalIds": {"DBLP": "journals/corr/abs-2505-07087", "DOI": "10.48550/arXiv.2505.07087", "CorpusId": 279469097}, "url": "https://www.semanticscholar.org/paper/1f87b1912fae41349875c567ca5465a6d51498b1", "title": "Architectural Precedents for General Agents using Large Language Models", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2505.07087?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2505.07087, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2257043801", "name": "Robert E. Wray"}, {"authorId": "145845123", "name": "James R. Kirk"}, {"authorId": "2257042720", "name": "John E. Laird"}], "abstract": null}}, {"citingPaper": {"paperId": "5f8987c83fee7ae64869dca2a99e4c9540146e40", "externalIds": {"DBLP": "journals/corr/abs-2508-01415", "DOI": "10.48550/arXiv.2508.01415", "CorpusId": 280421800}, "url": "https://www.semanticscholar.org/paper/5f8987c83fee7ae64869dca2a99e4c9540146e40", "title": "RoboMemory: A Brain-inspired Multi-memory Agentic Framework for Lifelong Learning in Physical Embodied Systems", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2508.01415?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2508.01415, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2345795967", "name": "Mingcong Lei"}, {"authorId": "2375975598", "name": "Honghao Cai"}, {"authorId": "2375138214", "name": "Binbin Que"}, {"authorId": "2376107083", "name": "Zezhou Cui"}, {"authorId": "2376157792", "name": "Liangchen Tan"}, {"authorId": "2374820374", "name": "Junkun Hong"}, {"authorId": "2375286530", "name": "Gehan Hu"}, {"authorId": "2374958537", "name": "Shuangyu Zhu"}, {"authorId": "2374923041", "name": "Yi-Mou Wu"}, {"authorId": "2374941483", "name": "Shao-Han Jiang"}, {"authorId": "2345743726", "name": "Ge Wang"}, {"authorId": "2348666284", "name": "Zhen Li"}, {"authorId": "2345843208", "name": "Shu-Guang Cui"}, {"authorId": "2345755411", "name": "Yi-Ming Zhao"}, {"authorId": "2336079506", "name": "Ya-Tong Han"}], "abstract": null}}, {"citingPaper": {"paperId": "4a8aa0e0d2a33195dc0fef07fabc30813229bf1d", "externalIds": {"DBLP": "journals/tmlr/SawyerKSERRHLRLMW25", "CorpusId": 284365142}, "url": "https://www.semanticscholar.org/paper/4a8aa0e0d2a33195dc0fef07fabc30813229bf1d", "title": "Exploring exploration with foundation agents in interactive environments", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2334473878", "name": "Danny P. Sawyer"}, {"authorId": "145604319", "name": "N. Ke"}, {"authorId": "2794457", "name": "Hubert Soyer"}, {"authorId": "3468172", "name": "Martin Engelcke"}, {"authorId": "2334477602", "name": "John Reid"}, {"authorId": "2334474280", "name": "David P. Reichert"}, {"authorId": "152951058", "name": "Drew A. Hudson"}, {"authorId": "2289726", "name": "Alexander Lerchner"}, {"authorId": "2302320004", "name": "Danilo Jimenez Rezende"}, {"authorId": "2542999", "name": "T. Lillicrap"}, {"authorId": "144473519", "name": "M. Mozer"}, {"authorId": "2334517184", "name": "Jane X Wang"}], "abstract": null}}, {"citingPaper": {"paperId": "09d8841eeb362a2c04f055f70f16d634093c83bc", "externalIds": {"DBLP": "journals/access/AcharyaKB25", "DOI": "10.1109/ACCESS.2025.3532853", "CorpusId": 275830329}, "url": "https://www.semanticscholar.org/paper/09d8841eeb362a2c04f055f70f16d634093c83bc", "title": "Agentic AI: Autonomous Intelligence for Complex Goals\u2014A Comprehensive Survey", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2025.3532853", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2025.3532853?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2025.3532853, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2064564791", "name": "D. Acharya"}, {"authorId": "2327269983", "name": "Karthigeyan Kuppan"}, {"authorId": "2351979049", "name": "B. Divya"}], "abstract": "Agentic AI, an emerging paradigm in artificial intelligence, refers to autonomous systems designed to pursue complex goals with minimal human intervention. Unlike traditional AI, which depends on structured instructions and close oversight, Agentic AI demonstrates adaptability, advanced decision-making capabilities and self-sufficiency, enabling it to operate dynamically in evolving environments. This survey thoroughly explores the foundational concepts, unique characteristics, and core methodologies driving the development of Agentic AI. We examine its current and potential applications across various fields, including healthcare, finance, and adaptive software systems, emphasizing the advantages of deploying agentic systems in real-world scenarios. The paper also addresses the ethical challenges posed by Agentic AI, proposing solutions for goal alignment, resource constraints, and environmental adaptability. We outline a framework for safely and effectively integrating Agentic AI into society, highlighting the need for further research on ethical considerations to ensure beneficial societal impacts. This survey serves as a comprehensive introduction to Agentic AI, guiding researchers, developers, and policymakers in engaging with its transformative potential responsibly and creatively."}}, {"citingPaper": {"paperId": "31563babef9147927150086779f9f06deb94a4aa", "externalIds": {"DBLP": "journals/access/JainK25", "DOI": "10.1109/ACCESS.2025.3538599", "CorpusId": 276121938}, "url": "https://www.semanticscholar.org/paper/31563babef9147927150086779f9f06deb94a4aa", "title": "Interacting Large Language Model Agents Bayesian Social Learning Based Interpretable Models", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2025.3538599", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2025.3538599?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2025.3538599, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2174870383", "name": "Adit Jain"}, {"authorId": "2162006071", "name": "Vikram Krishnamurthy"}], "abstract": "This paper discusses the theory and algorithms for interacting large language model agents (LLMAs) using methods from statistical signal processing and microeconomics. While both fields are mature, their application to decision-making involving interacting LLMAs remains unexplored. Motivated by Bayesian sentiment analysis on online platforms, we construct interpretable models and stochastic control algorithms that enable LLMAs to interact and perform Bayesian inference. Because interacting LLMAs learn from both prior decisions and external inputs, they can exhibit bias and herding behavior. Thus, developing interpretable models and stochastic control algorithms is essential to understand and mitigate these behaviors. This paper has three main results. First, we show using Bayesian revealed preferences from microeconomics that an individual LLMA satisfies the necessary and sufficient conditions for rationally inattentive (bounded rationality) Bayesian utility maximization and, given an observation, the LLMA chooses an action that maximizes a regularized utility. Second, we utilize Bayesian social learning to construct interpretable models for LLMAs that interact sequentially with each other and the environment while performing Bayesian inference. Our proposed models capture the herding behavior exhibited by interacting LLMAs. Third, we propose a stochastic control framework to delay herding and improve state estimation accuracy under two settings: 1) centrally controlled LLMAs and 2) autonomous LLMAs with incentives. Throughout the paper, we numerically demonstrate the effectiveness of our methods on real datasets for hate speech classification and product quality assessment, using open-source models like LLaMA and Mistral and closed-source models like ChatGPT. The main takeaway of this paper, based on substantial empirical analysis and mathematical formalism, is that LLMAs act as rationally bounded Bayesian agents that exhibit social learning when interacting. Traditionally, such models are used in economics to study interacting human decision-makers."}}, {"citingPaper": {"paperId": "60ab10ad7543bc7dcefd2a89f47d1793d2bb4122", "externalIds": {"DBLP": "journals/access/FukudaNO25", "DOI": "10.1109/ACCESS.2025.3544637", "CorpusId": 276586227}, "url": "https://www.semanticscholar.org/paper/60ab10ad7543bc7dcefd2a89f47d1793d2bb4122", "title": "Small Language Model Agent for the Operations of Continuously Updating ICT Systems", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2025.3544637", "status": "GOLD", "license": "CCBYNCND", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2025.3544637?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2025.3544637, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2008197594", "name": "Nobukazu Fukuda"}, {"authorId": "34682214", "name": "Haruhisa Nozue"}, {"authorId": "2065397536", "name": "Haruo Oishi"}], "abstract": "The management of ICT systems requires the implementation of appropriate operational procedures that are aligned with the specific system state and adhere to the latest updates and revisions of manuals and policies. The implementation of autonomous system operation has the potential to reduce the time and burden of human endeavors. Large Language Model (LLM) agents are expected to interact with ICT systems and operate them autonomously. However, existing LLM agents presume a sophisticated reasoning capability of API-based proprietary LLMs, which gives rise to concerns regarding operational costs and confidentiality. Therefore, we propose a novel framework for the Small Language Model (SLM) agent that is designed to adapt to a continuously updating environment. The proposed method addresses the limitation of the reasoning performance of the SLM agent using nested thoughts and prompt reconfiguration. In particular, we empirically identify the shortcut reasoning of the SLM agent and put forward an exemplar selection method to address this issue. We extensively evaluate the proposed method using both synthetic and real-world benchmarks and demonstrate that it significantly enhances the performance of the SLM agent with some computational overhead in comparison with the baselines."}}, {"citingPaper": {"paperId": "246f2a2389d18baf8cad0c9a95602e7c74643906", "externalIds": {"DBLP": "conf/nips/ZhouZYLYJZ25", "DOI": "10.52202/085713-2192", "CorpusId": 277993974}, "url": "https://www.semanticscholar.org/paper/246f2a2389d18baf8cad0c9a95602e7c74643906", "title": "WALL-E: World Alignment by NeuroSymbolic Learning improves World Model-based LLM Agents", "openAccessPdf": {"url": "https://arxiv.org/pdf/2504.15785", "status": "GREEN", "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.52202/085713-2192?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.52202/085713-2192, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2325198805", "name": "Si-Yu Zhou"}, {"authorId": "2268859756", "name": "Tianyi Zhou"}, {"authorId": "2349544439", "name": "Yijun Yang"}, {"authorId": "2293722046", "name": "Guodong Long"}, {"authorId": "2287821752", "name": "De-Heng Ye"}, {"authorId": "2268722420", "name": "Jing Jiang"}, {"authorId": "48934799", "name": "Cheng-Qi Zhang"}], "abstract": "action rules, knowledge graphs, and scene graphs. Step 4-5: The learned symbolic knowledge helps the world model make accurate predictions and correct the previous mistake. Step 6-7: The agent adjusts its decision accordingly and replaces stone pickaxe with iron pickaxe toward completing the task. Abstract Can we build accurate world models out of large language models (LLMs)? How can world models benefit LLM agents? The gap between the prior knowledge of LLMs and the specified environment\u2019s dynamics usually bottlenecks LLMs\u2019 performance as world models. To bridge the gap, we propose a training-free \u201c world alignment \u201d that learns an environment\u2019s symbolic knowledge complementary to LLMs. The symbolic knowledge covers action rules, knowledge graphs, and scene graphs, which are extracted by LLMs from exploration trajectories and encoded into executable codes to regulate LLM agents\u2019 policies. We further propose an RL-free, model-based agent \u201cWALL-E\u201d through the model-predictive control (MPC) framework. Unlike classical MPC requiring costly optimization on the fly, we adopt an LLM agent as an efficient look-ahead optimizer of future steps\u2019 actions by interacting with the neurosymbolic world model. While the LLM agent\u2019s strong heuristics make it an efficient planner in MPC, the quality of its planned actions is also secured by the accurate predictions of the aligned"}}, {"citingPaper": {"paperId": "7e8b6a8a718abeacc476551f5b4dfa8dbdaf0f43", "externalIds": {"DBLP": "journals/corr/abs-2506-12508", "DOI": "10.48550/arXiv.2506.12508", "CorpusId": 279402806}, "url": "https://www.semanticscholar.org/paper/7e8b6a8a718abeacc476551f5b4dfa8dbdaf0f43", "title": "AgentOrchestra: A Hierarchical Multi-Agent Framework for General-Purpose Task Solving", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2506.12508?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2506.12508, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2334920503", "name": "Wen-Tao Zhang"}, {"authorId": "2365110192", "name": "Ce Cui"}, {"authorId": "2267697818", "name": "Yi-Lei Zhao"}, {"authorId": "2263413652", "name": "Rui Hu"}, {"authorId": "2365077986", "name": "Yang Liu"}, {"authorId": "2263493641", "name": "Yahui Zhou"}, {"authorId": "2363859486", "name": "Bo An"}], "abstract": null}}, {"citingPaper": {"paperId": "3d343734acb39bf91b9fd88461484fd3d9433076", "externalIds": {"DBLP": "journals/corr/abs-2506-12482", "DOI": "10.48550/arXiv.2506.12482", "CorpusId": 279403581}, "url": "https://www.semanticscholar.org/paper/3d343734acb39bf91b9fd88461484fd3d9433076", "title": "Tiered Agentic Oversight: A Hierarchical Multi-Agent System for AI Safety in Healthcare", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2506.12482?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2506.12482, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2107937893", "name": "Y. Kim"}, {"authorId": "2299119896", "name": "H. Jeong"}, {"authorId": "2298091351", "name": "Chanwoo Park"}, {"authorId": "2362865475", "name": "Eugene Park"}, {"authorId": "2367201966", "name": "Haipeng Zhang"}, {"authorId": "2348937109", "name": "Xin Liu"}, {"authorId": "2329088002", "name": "Hyeonhoon Lee"}, {"authorId": "2315286830", "name": "D. Mcduff"}, {"authorId": "2804918", "name": "M. Ghassemi"}, {"authorId": "2287781906", "name": "Cynthia Breazeal"}, {"authorId": "2348191300", "name": "S. Tulebaev"}, {"authorId": "2329047452", "name": "H. Park"}], "abstract": null}}, {"citingPaper": {"paperId": "7602588799882306ecba2781f369b1c14a4865a0", "externalIds": {"DBLP": "journals/corr/abs-2506-01551", "DOI": "10.48550/arXiv.2506.01551", "CorpusId": 279118677}, "url": "https://www.semanticscholar.org/paper/7602588799882306ecba2781f369b1c14a4865a0", "title": "EvolveNav: Self-Improving Embodied Reasoning for LLM-Based Vision-Language Navigation", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2506.01551?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2506.01551, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2068281996", "name": "Bingqian Lin"}, {"authorId": "2290906495", "name": "Yun-Shuang Nie"}, {"authorId": "2304474255", "name": "Khun Loun Zai"}, {"authorId": "2290968842", "name": "Ziming Wei"}, {"authorId": "2334521542", "name": "Ming-Fei Han"}, {"authorId": "2289937096", "name": "Rong-Tao Xu"}, {"authorId": "40896269", "name": "Minzhe Niu"}, {"authorId": "47180442", "name": "Jian-Hua Han"}, {"authorId": "2316519420", "name": "Liang Lin"}, {"authorId": "2303415069", "name": "Ce-Wu Lu"}, {"authorId": "2279864033", "name": "Xiao-Dan Liang"}], "abstract": null}}, {"citingPaper": {"paperId": "de33f3d60a336985eeb67f46a4ae997982be3fd5", "externalIds": {"DBLP": "journals/corr/abs-2507-20021", "DOI": "10.48550/arXiv.2507.20021", "CorpusId": 280323613}, "url": "https://www.semanticscholar.org/paper/de33f3d60a336985eeb67f46a4ae997982be3fd5", "title": "When Engineering Outruns Intelligence: A Re-evaluation of Instruction-Guided Navigation", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2507.20021?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2507.20021, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2302798482", "name": "Matin Aghaei"}, {"authorId": "2090293292", "name": "Mohammad Ali Alomrani"}, {"authorId": "2320473255", "name": "Ying-Xue Zhang"}, {"authorId": "2283848217", "name": "Mahdi Biparva"}], "abstract": null}}]}
