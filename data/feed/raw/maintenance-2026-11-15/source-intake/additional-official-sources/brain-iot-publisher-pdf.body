	xplGlobal.document.metadata={"userInfo":{"institute":false,"member":false,"individual":false,"guest":false,"subscribedContent":false,"fileCabinetContent":false,"fileCabinetUser":false,"dtrDeleteCookieOnLogout":false,"institutionalFileCabinetUser":false,"dtrCookieExpirationDays":0,"showPatentCitations":true,"showGet802Link":false,"showOpenUrlLink":false,"tracked":false,"institutionUserId":0,"delegatedAdmin":false,"desktop":false,"isInstitutionDashboardEnabled":false,"isInstitutionProfileEnabled":false,"isRoamingEnabled":false,"isDelegatedAdmin":false,"isMdl":false,"isCwg":false,"isIel":false,"isAcademic":false,"isReadAndPublish":false},"authors":[{"name":"Tao Chen","affiliation":["Qingdao Software College and the College of Computer Science and Technology, China University of Petroleum (East China), Qingdao, China","Shandong Key Laboratory of Intelligent Oil and Gas Industrial Software, Qingdao, China","Shandong Provincial Laboratory of Data Open and Innovation Application, Qingdao, China"],"bio":{"p":["Tao Chen is currently pursuing the Ph.D. degree in computer science with the Big Data Intelligent Processing Team and the College of Computer Science and Technology, China University of Petroleum (East China), Qingdao, China.","His main research interests include data mining and social computing."]},"firstName":"Tao","lastName":"Chen","orcid":"0000-0002-3346-769X","id":"37089408810"},{"name":"MengMeng Sui","affiliation":["School of Computer and Artificial Intelligence, Lanzhou University of Technology, Lanzhou, China"],"bio":{"p":["MengMeng Sui is currently pursuing the master’s degree with Lanzhou University of Technology, Lanzhou, China.","Her research interests include natural language processing and multimodal sentiment analysis."]},"firstName":"MengMeng","lastName":"Sui","id":"221199568055429"},{"name":"Baoyu Zhang","affiliation":["Qingdao Software College and the College of Computer Science and Technology, China University of Petroleum (East China), Qingdao, China","Shandong Key Laboratory of Intelligent Oil and Gas Industrial Software, Qingdao, China","Shandong Provincial Laboratory of Data Open and Innovation Application, Qingdao, China"],"bio":{"p":["Baoyu Zhang is currently pursuing the Ph.D. degree in computer science with the Big Data Intelligent Processing Team and the College of Computer Science and Technology, China University of Petroleum (East China), Qingdao, China.","His main research interests include data mining, social computing, and natural language processing."]},"firstName":"Baoyu","lastName":"Zhang","orcid":"0000-0002-6518-1573","id":"37086729497"},{"name":"Shaohua Cao","affiliation":["Qingdao Software College and the College of Computer Science and Technology, China University of Petroleum (East China), Qingdao, China","Shandong Key Laboratory of Intelligent Oil and Gas Industrial Software, Qingdao, China","Shandong Provincial Laboratory of Data Open and Innovation Application, Qingdao, China"],"bio":{"p":["Shaohua Cao (Member, IEEE) received the B.S. and master’s degrees from China University of Petroleum (East China), Qingdao, China, in 2003 and 2013, respectively.","He was a Visiting Scholar with the University of New South Wales, Kensington, NSW, Australia, in 2008, and with Georgia State University, Atlanta, GA, USA, from 2019 to 2020. He is currently an Associate Professor with the College of Computer Science and Technology, China University of Petroleum (East China). His current research interests include SDN, cloud computing, and edge computing."]},"firstName":"Shaohua","lastName":"Cao","orcid":"0000-0001-8287-2942","id":"37086194063"},{"name":"Weishan Zhang","affiliation":["Qingdao Software College and the College of Computer Science and Technology, China University of Petroleum (East China), Qingdao, China","Shandong Key Laboratory of Intelligent Oil and Gas Industrial Software, Qingdao, China","Shandong Provincial Laboratory of Data Open and Innovation Application, Qingdao, China"],"bio":{"p":["Weishan Zhang (Member, IEEE) received the Ph.D. degree from Northwestern Polytechnical University, Xi’an, China, in 2001.","He is currently a Full Professor and the Deputy Head for research with the College of Computer Science and Technology, China University of Petroleum (East China), Qingdao, China. He has published more than 100 papers. His current H-index according to Google Scholar is 25. His current research interests include big data mining, social computing, and artificial intelligence."]},"firstName":"Weishan","lastName":"Zhang","orcid":"0000-0001-9800-1068","id":"37085410465"},{"name":"Lianyong Qi","affiliation":["Qingdao Software College and the College of Computer Science and Technology, China University of Petroleum (East China), Qingdao, China","Shandong Key Laboratory of Intelligent Oil and Gas Industrial Software, Qingdao, China"],"bio":{"p":["Lianyong Qi received the Ph.D. degree from the Department of Computer Science and Technology, Nanjing University, Nanjing, China, in 2011.","He is currently a Professor with China University of Petroleum (East China), Qingdao, China, and also with Shandong Key Laboratory of Intelligent Oil and Gas Industrial Software, Qingdao. His research interests include AI and recommender systems."]},"firstName":"Lianyong","lastName":"Qi","orcid":"0000-0001-9875-9856","id":"37532753900"},{"name":"Xiaoli Li","affiliation":["Information Systems Technology and Design Pillar, Singapore University of Technology and Design, Tampines, Singapore"],"bio":{"p":["Xiaoli Li (Fellow, IEEE) is currently a Full Professor and the Head of Pillar with the Information Systems Technology and Design (ISTD) Pillar, Singapore University of Technology and Design (SUTD), Singapore. He also holds an appointment as an Adjunct Full Professor with Nanyang Technological University (NTU), Singapore. He has published more than 390 papers in leading journals and conferences, with research interests including artificial intelligence (AI), data mining, machine learning, and bioinformatics.","Dr. Li is a fellow of AAIA. He has served as the area chair or senior program committee member for several premier AI and data mining conferences, and has received ten Best Paper and Benchmark Competition Awards. He is the Editor-in-Chief of the World Scientific Annual Review of Artificial Intelligence and serves as an Associate Editor of IEEE Transactions on Artificial Intelligence, Knowledge and Information Systems, and Machine Learning With Applications (Elsevier). Beyond academia, he actively collaborates with the industry, having established and led multiple joint laboratories and spearheaded more than ten major research and development partnerships with global organizations in aerospace, telecommunications, insurance, and professional services. His work has been internationally recognized, including being listed among the world’s top 2% of scientists in AI (Stanford University) and as a Clarivate Highly Cited Researcher."]},"firstName":"Xiaoli","lastName":"Li","orcid":"0000-0002-0762-6562","id":"37716715900"}],"issn":[{"format":"Electronic ISSN","value":"2327-4662"}],"articleNumber":"11673196","mediaPath":"/mediastore/IEEE/content/media/6488907/11780662/11673196","dbTime":"3 ms","metrics":{"wosCitationCount":0,"citationCountPaper":0,"citationCountPatent":0,"totalDownloads":30},"purchaseOptions":{"showOtherFormatPricingTab":false,"showPdfFormatPricingTab":true,"pdfPricingInfoAvailable":true,"otherPricingInfoAvailable":false,"mandatoryBundle":false,"optionalBundle":false,"displayTextWhenOtherFormatPricingNotAvailable":"The purchase and pricing options for this item are unavailable. Select items are only available as part of a subscription package. You may try again later or <a href='https://ieeexplore.ieee.org/xpl/contact' target='_blank'>contact us</a> for more information.","pdfPricingInfo":[{"memberPrice":"$16.00","nonMemberPrice":"$36.00","partNumber":"11673196","type":"PDF/HTML"}]},"getProgramTermsAccepted":false,"sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"false","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"false","relatedContent":"false","metrics":"true"},"pdfUrl":"/stamp/stamp.jsp?tp=&arnumber=11673196","displayPublicationTitle":"IEEE Internet of Things Journal","publicationDate":"15 November 2026","pdfPath":"/iel8/6488907/11780662/11673196.pdf","publicationYear":"2026","publicationTitle":"IEEE Internet of Things Journal","formulaStrippedArticleTitle":"Brain Cognition-Inspired Adaptable LLM Agents for Continuous Knowledge Reuse Across Tasks in IoT","keywords":[{"type":"IEEE Keywords","kwd":["Large language models","Internet of Things","Cognition","Modeling","Planning","Collaboration","Cognitive systems","Educational institutions","Memory","Compounds"]},{"type":"Index Terms","kwd":["Internet Of Things","Knowledge Reuse","Large Language Models","Knowledge Base","Human Cognition","Internet Of Things Applications","Smart Home","Synergistic Mechanism","Accumulation Of Knowledge","Bidirectional Flow","Dual-process Theory","Deliberate Planning","Capabilities Of Agents","Executive Function","Valuable Insights","Task Completion","Task Execution","Semantic Similarity","Planning System","Results Of Task","Reasoning Tasks","Knowledge Retrieval","Memory Mechanisms","Task Scenarios","Composition Operator","Heterogeneous Devices","Task Characteristics","Continuous Refinement","Average Step","Cognitive Architecture"]},{"type":"Author Keywords","kwd":["Brain cognition","embodied agents","intelligent agents","knowledge reuse","large language models (LLMs)"]}],"allowComments":false,"authorNames":"Tao Chen;MengMeng Sui;Baoyu Zhang;Shaohua Cao;Weishan Zhang;Lianyong Qi;Xiaoli Li","doiLink":"https://doi.org/10.1109/JIOT.2026.3729453","pubLink":"/xpl/RecentIssue.jsp?punumber=6488907","articleCopyRight":"2026 IEEE","rightsLink":"http://s100.copyright.com/AppDispatchServlet?publisherName=ieee&publication=6488907&title=Brain+Cognition-Inspired+Adaptable+LLM+Agents+for+Continuous+Knowledge+Reuse+Across+Tasks+in+IoT&isbn=&publicationDate=15+November+2026&author=Tao+Chen&ContentID=10.1109/JIOT.2026.3729453&orderBeanReset=true&startPage=53296&endPage=53307&volumeNum=13&issueNum=22","displayPublicationDate":"31 August 2026","dateOfInsertion":"31 August 2026","issueLink":"/xpl/tocresult.jsp?isnumber=11780662&punumber=6488907","startPage":"53296","endPage":"53307","abstract":"Large language model (LLM)-based agents are promising in Internet of Things (IoT) applications. However, existing agent systems suffer from an ephemeral limitation: agents are instantiated for individual tasks and terminated upon completion, losing valuable execution experiences across different tasks where past knowledge reuse is impossible. Inspired by dual-process theory in cognitive science, we propose a brain cognition-inspired dual-system agent framework for continuous knowledge reuse across heterogeneous task streams, termed the cognition-inspired dual-system agent framework for continuous knowledge reuse (CIA-CKR). The CIA-CKR framework separates fast (reactive execution) from slow (deliberative planning) cognition phases by maintaining a persistent knowledge base throughout the operational lifetime of agents. Two synergistic mechanisms are designed that mirror bidirectional knowledge flow in human cognition: a personalized agent generation mechanism that retrieves task-relevant knowledge and configures context-specific agent capabilities through top-down adaptation, and a knowledge accumulation mechanism that extracts experiential insights from execution traces through bottom-up feedback. Extensive experiments on HomeBench (smart home control) and OmniEAR (embodied multiagent collaboration) datasets demonstrate that CIA-CKR consistently outperforms both vanilla LLMs and recent memory-augmented methods, achieving 10.82% and 4.23% average accuracy improvements on HomeBench and OmniEAR, respectively, over the best baselines.","isGetAddressInfoCaptured":false,"isMarketingOptIn":false,"pubTopics":[{"name":"Computing and Processing"},{"name":"Communication, Networking and Broadcast Technologies"}],"publisher":"IEEE","isProduct":false,"displayDocTitle":"Brain Cognition-Inspired Adaptable LLM Agents for Continuous Knowledge Reuse Across Tasks in IoT","isChapter":false,"isJournal":true,"isConference":false,"isTutorial":false,"isFreeDocument":false,"isDynamicHtml":true,"isEarlyAccess":false,"isOpenAccess":false,"isEphemera":false,"isBookWithoutChapters":false,"volume":"13","issue":"22","isSpringer":false,"isStandard":false,"isBook":false,"xploreDocumentType":"Journals & Magazine","isCustomDenial":false,"isSMPTE":false,"htmlLink":"/document/11673196/","isSAE":false,"isDegruyter":false,"isOUP":false,"isNow":false,"htmlAbstractLink":"/document/11673196/","isLatestStandard":false,"hasStandardVersions":false,"isGiveaway":false,"isTranslation":false,"persistentLink":"https://ieeexplore.ieee.org/servlet/opac?punumber=6488907","isOnlineOnly":false,"isPromo":false,"startPage":"53296","fundingAgencies":{"fundingAgency":[{"fundingId":"10.13039/501100001809","fundingName":"National Natural Science Foundation of China","grantNumber":"92567204 and 62072469"},{"fundingId":"10.13039/501100020196","fundingName":"Shandong Provincial Natural Science Foundation Major Basic Research Program","grantNumber":"ZR2024ZD20"},{"fundingName":"Shandong Data Open Innovative Application Laboratory"}]},"articleCopyRight":"2026 IEEE","openAccessFlag":"F","insertDate":"31 August 2026","ephemeraFlag":"false","title":"Brain Cognition-Inspired Adaptable LLM Agents for Continuous Knowledge Reuse Across Tasks in IoT","html_flag":"false","ml_html_flag":"true","sourcePdf":"jiot-cao-3729453-x.pdf","displayPublicationDate":"31 August 2026","mlTime":"PT0.058983S","xplore-pub-id":"6488907","pdfPath":"/iel8/6488907/11780662/11673196.pdf","isNumber":"11780662","rightsLinkFlag":"1","contentType":"periodicals","publicationDate":"15 November 2026","publicationNumber":"6488907","xplore-issue":"11780662","issue":"22","articleId":"11673196","publicationTitle":"IEEE Internet of Things Journal","sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"false","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"false","relatedContent":"false","metrics":"true"},"volume":"13","contentTypeDisplay":"Journals","referenceCount":35,"publicationYear":"2026","subType":"IEEE Journal","_value":"IEEE","lastupdate":"2026-11-09","mediaPath":"/mediastore/IEEE/content/media/6488907/11780662/11673196","endPage":"53307","displayPublicationTitle":"IEEE Internet of Things Journal","doi":"10.1109/JIOT.2026.3729453"};








