e": "Sara Fish"}, {"authorId": "2356412668", "name": "Julia Shephard"}, {"authorId": "2356477569", "name": "Minkai Li"}, {"authorId": "2953097", "name": "Ran I. Shorrer"}, {"authorId": "1708772", "name": "Yannai A. Gonczarowski"}], "abstract": null}}, {"citingPaper": {"paperId": "b5b877d1e397e75a60e874967258392cf789370e", "externalIds": {"DBLP": "conf/coria/VersmeeRKV25", "CorpusId": 281830420}, "url": "https://www.semanticscholar.org/paper/b5b877d1e397e75a60e874967258392cf789370e", "title": "AutoCluster: Un agent pour le clustering bas\u00e9 sur les grands mod\u00e8les de langue", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2383981415", "name": "Erwan Versm\u00e9e"}, {"authorId": "2157969664", "name": "Youcef Remil"}, {"authorId": "1401910638", "name": "Mehdi Kaytoue-Uberall"}, {"authorId": "2065431425", "name": "Julien Velcin"}], "abstract": null}}, {"citingPaper": {"paperId": "841216259bb4340f681ffb7a3af27668d5084e68", "externalIds": {"DBLP": "journals/corr/abs-2510-18442", "DOI": "10.48550/arXiv.2510.18442", "CorpusId": 283049886}, "url": "https://www.semanticscholar.org/paper/841216259bb4340f681ffb7a3af27668d5084e68", "title": "PlanU: Large Language Model Decision Making through Planning under Uncertainty", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2510.18442?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2510.18442, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2356394356", "name": "Zi-Wei Deng"}, {"authorId": "2343843315", "name": "Mian Deng"}, {"authorId": "2391012856", "name": "Chen-Jing Liang"}, {"authorId": "2386939843", "name": "Zeming Gao"}, {"authorId": "2265459846", "name": "Chennan Ma"}, {"authorId": "2355307401", "name": "Chenxing Lin"}, {"authorId": "2386931950", "name": "Hai-Peng Zhang"}, {"authorId": "3241072", "name": "Songzhu Mei"}, {"authorId": "2344265069", "name": "Cheng Wang"}, {"authorId": "2197020734", "name": "Si-Qi Shen"}], "abstract": null}}, {"citingPaper": {"paperId": "89f59dc45cd9d3ed7429af90602e13a8e68ac2c3", "externalIds": {"DBLP": "journals/corr/abs-2511-18203", "DOI": "10.48550/arXiv.2511.18203", "CorpusId": 283243694}, "url": "https://www.semanticscholar.org/paper/89f59dc45cd9d3ed7429af90602e13a8e68ac2c3", "title": "SkillWrapper: Generative Predicate Invention for Skill Abstraction", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2511.18203?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2511.18203, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2358003903", "name": "Zi-Yi Yang"}, {"authorId": "2145960988", "name": "Benned Hedegaard"}, {"authorId": "2334481158", "name": "Ahmed Jaafar"}, {"authorId": "2334614199", "name": "Yi-Chen Wei"}, {"authorId": "2395418346", "name": "Skye Thompson"}, {"authorId": "2242964116", "name": "S. S. Raman"}, {"authorId": "81875788", "name": "Haotian Fu"}, {"authorId": "2257278948", "name": "Stefanie Tellex"}, {"authorId": "1765407", "name": "G. Konidaris"}, {"authorId": "7818698", "name": "D. Paulius"}, {"authorId": "2357772008", "name": "Naman Shah"}], "abstract": null}}, {"citingPaper": {"paperId": "8b8cd4b