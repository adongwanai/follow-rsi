ionDate": null, "authors": [{"authorId": "2334822553", "name": "Yu-Jie Zhao"}, {"authorId": "2258334187", "name": "Lan-Xiang Hu"}, {"authorId": "2470771832", "name": "Yang Wang"}, {"authorId": "2324000474", "name": "Minmin Hou"}, {"authorId": "2343825082", "name": "Hao Zhang"}, {"authorId": "2343636185", "name": "Ke Ding"}, {"authorId": "2278568030", "name": "Ji-Shen Zhao"}], "abstract": null}}, {"citingPaper": {"paperId": "ca8316bae22e9de13801af28d61254809b619799", "externalIds": {"DBLP": "journals/corr/abs-2511-00447", "DOI": "10.48550/arXiv.2511.00447", "CorpusId": 283892287}, "url": "https://www.semanticscholar.org/paper/ca8316bae22e9de13801af28d61254809b619799", "title": "DRIP: Defending Prompt Injection via De-instruction Training and Residual Fusion Model Architecture", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2511.00447?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2511.00447, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2312672359", "name": "Ruo-Fan Liu"}, {"authorId": "2312343648", "name": "Yun Lin"}, {"authorId": "2152487387", "name": "Jin-Song Dong"}], "abstract": null}}, {"citingPaper": {"paperId": "e0450107477cb64928c4972e6f0cb8da6e2b0ed9", "externalIds": {"DBLP": "journals/corr/abs-2512-03356", "DOI": "10.48550/arXiv.2512.03356", "CorpusId": 284964892}, "url": "https://www.semanticscholar.org/paper/e0450107477cb64928c4972e6f0cb8da6e2b0ed9", "title": "Immunity memory-based jailbreak detection: multi-agent adaptive guard for large language models", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2512.03356?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2512.03356, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2395896068", "name": "Jun Leng"}, {"authorId": "2292634820", "name": "Li-Tian Zhang"}, {"authorId": "2313047395", "name": "Xi Zhang"}], "abstract": null}}, {"citingPaper": {"paperId": "5848eca4df00b7ca935225ef431cad2fc150099f", "externalIds": {"DBLP": "journals/corr/abs-2502-05907", "DOI": "10.48550/arXiv.2502.05907", "CorpusId": 285305439}, "url": "https://www.semanticscholar.org/paper/5848eca4df00b7ca935225ef431cad2fc150099f", "title": "EvoAgent: Agent Autonomous Evolution with Continual World Model for Long-Horizon Tasks", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2502.05907?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2502.05907, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2314118951", "name": "Tong-Tong Feng"}, {"authorId": "2314795869", "name": "Xin Wang"}, {"authorId": "2344789734", "name": "Zekai Zhou"}, {"authorId": "2344790258", "name": "Ren Wang"}, {"authorId": "2344770795", "name": "Yu-Wei Zhan"}, {"authorId": "2314836124", "name": "Guang-Yao Li"}, {"authorId": "2314970366", "name": "Qing Li"}, {"authorId": "2156154955", "name": "Wen-Wu Zhu"}], "abstract": null}}, {"citingPaper": {"paperId": "cc3842b5893a3c998c4231f48b1ff1cdae7ee4bc", "externalIds": {"DBLP": "conf/greenai/AsafGLLMS25", "CorpusId": 285671319}, "url": "https://www.semanticscholar.org/paper/cc3842b5893a3c998c4231f48b1ff1cdae7ee4bc", "title": "LUMI Agents: A Fuzzy BDI Framework for Intelligent Agents", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2141421610", "name": "Muhammad Asaf"}, {"authorId": "2404529423", "name": "Paola Guarasci"}, {"authorId": "2404526837", "name": "Domenico Laurito"}, {"authorId": "92815360", "name": "David M Longo"}, {"authorId": "10224771", "name": "Angelo Mendicelli"}, {"authorId": "1764248", "name": "Francesco Scarcello"}], "abstract": null}}, {"citingPaper": {"paperId": "b908ea80bb75cf4b4f0c4ab4586d36ce72b4b4fd", "externalIds": {"DBLP": "conf/ranlp/KrishnamoorthyIA25", "DOI": "10.26615/978-954-452-098-4-070", "CorpusId": 284798886}, "url": "https://www.semanticscholar.org/paper/b908ea80bb75cf4b4f0c4ab4586d36ce72b4b4fd", "title": "Multi-Agent Reinforcement Learning for Interactive Code Debugging with Human Feedback and Memory", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.26615/978-954-452-098-4-070?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.26615/978-954-452-098-4-070, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "144768593", "name": "A. Krishnamoorthy"}, {"authorId": "2428991710", "name": "Kartik Ivatury"}, {"authorId": "31579242", "name": "Benyamin Ahmadnia"}], "abstract": "This paper introduces an interactive Python de-bugging framework that combines multi-agent reinforcement learning, Natural Language Processing (NLP), and long-term memory. Two Proximal Policy Optimization (PPO) agents specialize in syntax and logic errors, generating candidate fixes that developers can accept, reject, or refine. A BERT-based module encodes natural language feedback into dense embeddings and quality scores, which shape reward signals for Reinforcement Learning from Human Feedback (RLHF). To support personalization, the system uses dual FAISS indices to retrieve past fixes based on code-error pairs and developer explanations. Evaluated on a synthetic dataset of 200 Python programs, our approach achieves an 88% syntax-fix rate and 45% logic-fix rate within five sug-gestions\u2014outperforming one-shot Large Language Model (LLM) baselines. In addition, the system improves the quality of the explanation, as measured by BLEU, ROUGE, and Code-BLEU. By integrating multi-agent specialization, linguistic feedback, and memory-driven retrieval, our framework delivers a more efficient, adaptive, and developer-aligned debugging experience."}}, {"citingPaper": {"paperId": "aaf9fd56b36a306b1944f1fe5625f3783ae13688", "externalIds": {"DBLP": "conf/nips/YaoSXFGL25", "DOI": "10.52202/085713-0587", "CorpusId": 288421587}, "url": "https://www.semanticscholar.org/paper/aaf9fd56b36a306b1944f1fe5625f3783ae13688", "title": "Can Dependencies Induced by LLM-Agent Workflows Be Trusted?", "openAccessPdf": {"url": "", "status": "CLOSED", "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.52202/085713-0587?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.52202/085713-0587, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2313702049", "name": "Yu Yao"}, {"authorId": "2340114137", "name": "Yi-Liao Song"}, {"authorId": "2334323957", "name": "Yi Xie"}, {"authorId": "2314108998", "name": "Mengdan Fan"}, {"authorId": "2276749659", "name": "Ming-Yu Guo"}, {"authorId": "2334506046", "name": "Tong-Liang Liu"}], "abstract": "LLM-agent systems often decompose high-level objectives into subtask dependency graphs, assuming that each subtask\u2019s output is reliable and conditionally independent of others given its parent responses. However, this assumption frequently breaks during execution, as ground-truth responses are inaccessible, leading to inter-agent misalignment \u2014failures caused by inconsistencies and coordination breakdowns among agents [1]. To address this, we propose S EQ CV, a dynamic framework for reliable execution under violated conditional independence. S EQ CV executes subtasks sequentially, each conditioned on all prior verified responses, and performs consistency checks immediately after agents generate short token sequences. At each checkpoint, a token sequence is accepted only if it represents shared knowledge consistently supported across diverse LLM models; otherwise, it is discarded, triggering recursive subtask decomposition for finer-grained reasoning. Despite its sequential nature, S EQ CV avoids repeated corrections on the same misalignment and achieves higher effective throughput than parallel pipelines. Across multiple reasoning and coordination tasks, S EQ CV improves accuracy by up to 30% over existing LLM-agent systems. Code is available at github.com/tmllab/2025_NeurIPS_SeqCV ."}}, {"citingPaper": {"paperId": "e4c078770cf9544dfe4b75ba8522d9c856271973", "externalIds": {"DBLP": "conf/icml/Nie000CLC25", "CorpusId": 283566612}, "url": "https://www.semanticscholar.org/paper/e4c078770cf9544dfe4b75ba8522d9c856271973", "title": "EVOLvE: Evaluating and Optimizing LLMs For In-Context Exploration", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2253756381", "name": "Allen Nie"}, {"authorId": "2240772267", "name": "Yi Su"}, {"authorId": "71554432", "name": "Bo-Yu Chang"}, {"authorId": "120703894", "name": "Jonathan N. Lee"}, {"authorId": "2226805", "name": "Ed H. Chi"}, {"authorId": "2256995069", "name": "Quoc V. Le"}, {"authorId": "1743082", "name": "Min-Min Chen"}], "abstract": null}}, {"citingPaper": {"paperId": "a103984e47f9cc32b574ca776b29ffbf0c3e113c", "externalIds": {"DBLP": "conf/nips/ZhangLZLLLXZLZY25", "DOI": "10.52202/085713-2305", "CorpusId": 288815853}, "url": "https://www.semanticscholar.org/paper/a103984e47f9cc32b574ca776b29ffbf0c3e113c", "title": "SSRB: Direct Natural Language Querying to Massive Heterogeneous Semi-Structured Data", "openAccessPdf": {"url": "", "status": "CLOSED", "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.52202/085713-2305?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.52202/085713-2305, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2262020955", "name": "Xin Zhang"}, {"authorId": "2239393068", "name": "Ming-Xin Li"}, {"authorId": "2107949588", "name": "Yanzhao Zhang"}, {"authorId": "8427191", "name": "Ding-Kun Long"}, {"authorId": "2257099189", "name": "Yong-Qi Li"}, {"authorId": "2295785468", "name": "Ying-Hui Li"}, {"authorId": "2257348206", "name": "Peng-Jun Xie"}, {"authorId": "2257796182", "name": "Mei-Shan Zhang"}, {"authorId": "2405750479", "name": "Wen-Jie Li"}, {"authorId": "2295116281", "name": "Min Zhang"}, {"authorId": "2362057840", "name": "Philip S. Yu"}], "abstract": "Searching over semi-structured data with natural language (NL) queries has at-tracted sustained attention, enabling broader audiences to access information easily. As more applications, such as LLM agents and RAG systems, emerge to search and interact with semi-structured data, two major challenges have become evident: (1) the increasing diversity of domains and schema variations, making domain-customized solutions prohibitively costly; (2) the growing complexity of NL queries, which combine both exact field matching conditions and fuzzy semantic requirements, often involving multiple fields and implicit reasoning. These challenges make formal language querying or keyword-based search insufficient. In this work, we explore neural retrievers as a unified non-formal querying solu-tion by directly index semi-structured collections and understand NL queries. We employ LLM-based automatic evaluation and build a large-scale semi-structured retrieval benchmark ( SSRB ) using LLM generation and filtering, containing 14M semi-structured objects from 99 different schemas across 6 domains, along with 8,485 test queries that combine both exact and fuzzy matching conditions. Our systematic evaluation of popular retrievers shows that current state-of-the-art models could achieve acceptable performance, yet they still lack precise understanding of matching constraints. While by in-domain training of dense retrievers, the performance can be significantly improved. We believe that our SSRB could serve as a valuable resource for future research in this area, and we hope to inspire further exploration of semi-structured retrieval with complex queries."}}, {"citingPaper": {"paperId": "f0f151a23bf6a045369eb42468685dc2dfffdae2", "externalIds": {"DBLP": "conf/nips/ZhouMWY25", "DOI": "10.52202/085713-4246", "CorpusId": 289185876}, "url": "https://www.semanticscholar.org/paper/f0f151a23bf6a045369eb42468685dc2dfffdae2", "title": "Enhancing LLM Planning for Robotics Manipulation through Hierarchical Procedural Knowledge Graphs", "openAccessPdf": {"url": "", "status": "CLOSED", "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.52202/085713-4246?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.52202/085713-4246, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2300803972", "name": "Jia-Cong Zhou"}, {"authorId": "1410814291", "name": "Jia-Xu Miao"}, {"authorId": "2305810189", "name": "Xian-Yun Wang"}, {"authorId": "2224084129", "name": "Jun Yu"}], "abstract": "Large Language Models (LLMs) have shown the promising planning capabilities for robotic manipulation, which advances the development of embodied intelligence significantly. However, existing LLM-driven robotic manipulation approaches excel at simple pick-and-place tasks but are insufficient for complex manipulation tasks due to inaccurate procedural knowledge. Besides, for embodied intelligence, equipping a large scale LLM is energy-consuming and inefficient, which affects its real-world application. To address the above problems, we propose Hierarchical Procedural Knowledge Graphs ( HP-KG ) to enhance LLMs for complex robotic planning while significantly reducing the demand for LLM scale in robotic manipulation. Considering that the complex real-world tasks require multiple steps, and each step is composed of robotic-understandable atomic actions, we design a hierarchical knowledge graph structure to model the relationships between tasks, steps, and actions. This design bridges the gap between human instructions and robotic manipulation actions. To construct HP-KG, we develop an automatic knowledge graph construction framework powered by LLM-based multi-agents, which eliminates costly manual efforts while maintaining high-quality graph"}}, {"citingPaper": {"paperId": "2336ce3b09ad161def6c869c2a4ebbe84bf679dd", "externalIds": {"DBLP": "journals/corr/abs-2510-15259", "DOI": "10.48550/arXiv.2510.15259", "CorpusId": 290094140}, "url": "https://www.semanticscholar.org/paper/2336ce3b09ad161def6c869c2a4ebbe84bf679dd", "title": "Experience-Driven Exploration for Efficient API-Free AI Agents", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2510.15259?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2510.15259, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "152770073", "name": "Chen-Wei Tang"}, {"authorId": "2356552821", "name": "Jing-Yu Xing"}, {"authorId": "2386891915", "name": "Xin-Yu Liu"}, {"authorId": "2117415588", "name": "Zi-Zhou Wang"}, {"authorId": "2322018360", "name": "Jia-Wei Du"}, {"authorId": "2356553261", "name": "Liang-Li Zhen"}, {"authorId": "2268304741", "name": "Jian-Cheng Lv"}], "abstract": null}}, {"citingPaper": {"paperId": "1f0f4699ed5162f9839b7fd16e1fad273d407de7", "externalIds": {"DBLP": "conf/nips/NiDLLWZYRGLC25", "DOI": "10.52202/085713-0802", "CorpusId": 290858910}, "url": "https://www.semanticscholar.org/paper/1f0f4699ed5162f9839b7fd16e1fad273d407de7", "title": "Collaborative Reasoner: Self-Improving Social Agents with Synthetic Conversations", "openAccessPdf": {"url": "", "status": "CLOSED", "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.52202/085713-0802?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.52202/085713-0802, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2372245747", "name": "An-Song Ni"}, {"authorId": "2265650981", "name": "Ruta Desai"}, {"authorId": "2394390868", "name": "Yang Li"}, {"authorId": "2384335758", "name": "Xin-Jie Lei"}, {"authorId": "2346112830", "name": "Dong Wang"}, {"authorId": "2276519831", "name": "Jiemin Zhang"}, {"authorId": "2335694075", "name": "Jane Yu"}, {"authorId": "2373720606", "name": "Ramya Raghavendra"}, {"authorId": "2374403535", "name": "Gargi Ghosh"}, {"authorId": "2530311", "name": "Shang-Wen Li"}, {"authorId": "2288520099", "name": "Asli Celikyilmaz"}], "abstract": "With increasingly powerful large language models (LLMs) and LLM-based agents tackling an ever-growing list of tasks, we envision a future where numerous LLM agents work seamlessly with other AI agents and humans to solve complex problems and enhance daily life. To achieve these goals, LLM agents must develop collaborative skills such as effective persuasion, assertion and disagreement, which are often overlooked in the prevalent single-turn training and evaluation of LLMs. In this work, we present Collaborative Reasoner ( Coral ), a framework to evaluate and improve the collaborative reasoning abilities of language models. In particular, tasks and metrics in Coral necessitate agents to disagree with incorrect solutions, convince their partners of a correct solution, and ultimately agree as a team to commit to a final solution, all through a natural multi-turn conversation. Through comprehensive evaluation on six collaborative reasoning tasks covering domains of coding, math, scientific QA and social reasoning, we show that current models cannot effectively collaborate due to undesirable social behaviors, collapsing even on problems that they can solve singlehandedly. To improve the collaborative reasoning capabilities of LLMs, we propose a self-play method to generate synthetic multi-turn preference data and further train the language models to be better collaborators. Experiments with Llama-3.1 , Ministral and Qwen-2.5 models show that our proposed self-improvement approach consistently outperforms finetuned chain-of-thought performance of the same base model, yielding gains up to 16.7% absolute. Human evaluations show that the models exhibit more effective disagreement and produce more natural conversations after training on our synthetic interaction data. 1"}}, {"citingPaper": {"paperId": "1412f5ee973976e6c69f972e8427d1adba02e3ed", "externalIds": {"DBLP": "journals/corr/abs-2403-03186", "DOI": "10.48550/arXiv.2403.03186", "CorpusId": 271040254}, "url": "https://www.semanticscholar.org/paper/1412f5ee973976e6c69f972e8427d1adba02e3ed", "title": "Towards General Computer Control: A Multimodal Agent for Red Dead Redemption II as a Case Study", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2403.03186?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2403.03186, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2281324573", "name": "Weihao Tan"}, {"authorId": "1742314398", "name": "Zi-Luo Ding"}, {"authorId": "2267419431", "name": "Wen-Tao Zhang"}, {"authorId": "2290141409", "name": "Boyu Li"}, {"authorId": "2290134533", "name": "Bo-Han Zhou"}, {"authorId": "2290003920", "name": "Jun-Peng Yue"}, {"authorId": "2240541212", "name": "Hao-Chong Xia"}, {"authorId": "46179766", "name": "Jiechuan Jiang"}, {"authorId": "2115811864", "name": "Long-Tao Zheng"}, {"authorId": "2290204996", "name": "Xinrun Xu"}, {"authorId": "2290021357", "name": "Yifei Bi"}, {"authorId": "2175279893", "name": "Peng-Jie Gu"}, {"authorId": "10737491", "name": "Xin-Run Wang"}, {"authorId": "2047947436", "name": "B\u00f6rje F. Karlsson"}, {"authorId": "2303463181", "name": "Bo An"}, {"authorId": "2258676670", "name": "Zong-Qing Lu"}], "abstract": null}}, {"citingPaper": {"paperId": "7eff8e646fe0d76f196e637d8e86ee0ea64561af", "externalIds": {"DBLP": "journals/corr/abs-2401-15098", "DOI": "10.48550/arXiv.2401.15098", "CorpusId": 267500832}, "url": "https://www.semanticscholar.org/paper/7eff8e646fe0d76f196e637d8e86ee0ea64561af", "title": "Hi-Core: Hierarchical Knowledge Transfer for Continual Reinforcement Learning", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2401.15098?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2401.15098, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2281826491", "name": "Chao-Fan Pan"}, {"authorId": "2275293578", "name": "Xin Yang"}, {"authorId": "2276497124", "name": "Hao Wang"}, {"authorId": "2257053533", "name": "Wei Wei"}, {"authorId": "2491544499", "name": "Tian-Rui Li"}], "abstract": null}}, {"citingPaper": {"paperId": "13272e773654848d511c123fcc268a93d150a9a2", "externalIds": {"DBLP": "journals/corr/abs-2403-15698", "DOI": "10.48550/arXiv.2403.15698", "CorpusId": 268681484}, "url": "https://www.semanticscholar.org/paper/13272e773654848d511c123fcc268a93d150a9a2", "title": "SceneX: Procedural Controllable Large-scale Scene Generation via Large-language Models", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2403.15698?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2403.15698, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2293354103", "name": "Meng-Qi Zhou"}, {"authorId": "2293906437", "name": "Jun Hou"}, {"authorId": "49138914", "name": "Chuanchen Luo"}, {"authorId": "2115829788", "name": "Yu-Xi Wang"}, {"authorId": "2275640032", "name": "Zhao-Xiang Zhang"}, {"authorId": "2243329942", "name": "Jun-Ran Peng"}], "abstract": null}}, {"citingPaper": {"paperId": "8c30fa1242bec1926693a647e6247f0e3b2dfed0", "externalIds": {"DBLP": "journals/corr/abs-2405-16247", "DOI": "10.48550/arXiv.2405.16247", "CorpusId": 270063765}, "url": "https://www.semanticscholar.org/paper/8c30fa1242bec1926693a647e6247f0e3b2dfed0", "title": "AutoManual: Generating Instruction Manuals by LLM Agents via Interactive Environmental Learning", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2405.16247?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2405.16247, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2276034736", "name": "Minghao Chen"}, {"authorId": "2303406595", "name": "Yihang Li"}, {"authorId": "2303415296", "name": "Yan-Ting Yang"}, {"authorId": "2304150758", "name": "Shiyu Yu"}, {"authorId": "2258304162", "name": "Bin-Bin Lin"}, {"authorId": "2257432345", "name": "Xiaofei He"}], "abstract": null}}, {"citingPaper": {"paperId": "0bf2808126242e36e4a7972522ba961a39beb8e5", "externalIds": {"DBLP": "journals/corr/abs-2404-11483", "DOI": "10.48550/arXiv.2404.11483", "CorpusId": 271645749}, "url": "https://www.semanticscholar.org/paper/0bf2808126242e36e4a7972522ba961a39beb8e5", "title": "AgentKit: Flow Engineering with Graphs, not Coding", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2404.11483?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2404.11483, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2253837062", "name": "Yue Wu"}, {"authorId": "2166103953", "name": "Ye-Wen Fan"}, {"authorId": "2008204295", "name": "So Yeon Min"}, {"authorId": "9358910", "name": "Shrimai Prabhumoye"}, {"authorId": "143953836", "name": "Stephen Mcaleer"}, {"authorId": "3312309", "name": "Yonatan Bisk"}, {"authorId": "2256996419", "name": "Ruslan Salakhutdinov"}, {"authorId": "2256011166", "name": "Yuan-Zhi Li"}, {"authorId": "2253469786", "name": "Tom M. Mitchell"}], "abstract": null}}, {"citingPaper": {"paperId": "44e34ae3180a62eceb5ede8122647ca1b998b62f", "externalIds": {"DBLP": "journals/corr/abs-2410-15281", "DOI": "10.48550/arXiv.2410.15281", "CorpusId": 273501731}, "url": "https://www.semanticscholar.org/paper/44e34ae3180a62eceb5ede8122647ca1b998b62f", "title": "Large Language Models for Autonomous Driving (LLM4AD): Concept, Benchmark, Simulation, and Real-Vehicle Experiment", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2410.15281?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2410.15281, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2242949023", "name": "C. Cui"}, {"authorId": "2109267955", "name": "Yunsheng Ma"}, {"authorId": "2267506629", "name": "Zi-Chong Yang"}, {"authorId": "2275030995", "name": "Yu-Peng Zhou"}, {"authorId": "2271451076", "name": "Peiran Liu"}, {"authorId": "2053819036", "name": "Juan-Wu Lu"}, {"authorId": "2282544504", "name": "Ling-Xi Li"}, {"authorId": "2327177899", "name": "Yao-Bin Chen"}, {"authorId": "1757039", "name": "J. Panchal"}, {"authorId": "48846470", "name": "Amr Abdelraouf"}, {"authorId": "2261696435", "name": "Rohit Gupta"}, {"authorId": "2261909117", "name": "Kyungtae Han"}, {"authorId": "4141749", "name": "Zi-Ran Wang"}], "abstract": null}}, {"citingPaper": {"paperId": "82cbf4ce6db5c5d7ec6ffdbcfd3147e6c8f33df5", "externalIds": {"DBLP": "conf/nips/ChenW0JFYW24", "DOI": "10.52202/079017-0600", "CorpusId": 276185269}, "url": "https://www.semanticscholar.org/paper/82cbf4ce6db5c5d7ec6ffdbcfd3147e6c8f33df5", "title": "Policy Learning from Tutorial Books via Understanding, Rehearsing and Introspecting", "openAccessPdf": {"url": "https://discovery.ucl.ac.uk/10207118/1/7398_Policy_Learning_from_Tuto.pdf", "status": "GREEN", "license": "other-oa", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.52202/079017-0600?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.52202/079017-0600, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2108968873", "name": "Xiong-Hui Chen"}, {"authorId": "2142663126", "name": "Ziyan Wang"}, {"authorId": "2269828122", "name": "Ya-Li Du"}, {"authorId": "2119326931", "name": "Shengyi Jiang"}, {"authorId": "2257271855", "name": "Meng Fang"}, {"authorId": "2344591380", "name": "Yang Yu"}, {"authorId": "2257572528", "name": "Jun Wang"}], "abstract": "When humans need to learn a new skill, we can acquire knowledge through written books, including textbooks, tutorials, etc. However, current research for decision-making, like reinforcement learning (RL), has primarily required numerous real interactions with the target environment to learn a skill, while failing to utilize the existing knowledge already summarized in the text. The success of Large Language Models (LLMs) sheds light on utilizing such knowledge behind the books. In this paper, we discuss a new policy learning problem called P olicy L earning from tutorial B ooks (PLfB) upon the shoulders of LLMs\u2019 systems, which aims to leverage rich resources such as tutorial books to derive a policy network. Inspired by how humans learn from books, we solve the problem via a three-stage framework: U nderstanding, R ehearsing, and I ntrospecting (URI). In particular, it first rehearses decision-making trajectories based on the derived knowledge after understanding the books, then introspects about the imaginary dataset to distill a policy network. We build two benchmarks for PLfB based on Tic-Tac-Toe and Football games. In the experiment, URI\u2019s policy achieves a minimum of 44% net winning rate against GPT-based agents without any real data. In the much more complex football game, URI\u2019s policy beat the built-in AIs with a 37% winning rate while GPT-based agents can only achieve a 6% winning rate. The project page"}}, {"citingPaper": {"paperId": "be940a313721eff13183e7c3c17ea2a6ad93f567", "externalIds": {"DBLP": "journals/corr/abs-2403-16689", "DOI": "10.48550/arXiv.2403.16689", "CorpusId": 279031508}, "url": "https://www.semanticscholar.org/paper/be940a313721eff13183e7c3c17ea2a6ad93f567", "title": "Synapse: Learning Preferential Concepts from Visual Demonstrations", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2403.16689?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2403.16689, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2274501520", "name": "Sadanand Modak"}, {"authorId": "1577978380", "name": "Noah T Patton"}, {"authorId": "1714075", "name": "I. Dillig"}, {"authorId": "2267334183", "name": "Joydeep Biswas"}], "abstract": null}}, {"citingPaper": {"paperId": "a25e131813cb42e0809faed6204b8d39bf290978", "externalIds": {"DBLP": "journals/corr/abs-2404-07774", "DOI": "10.48550/arXiv.2404.07774", "CorpusId": 269042745}, "url": "https://www.semanticscholar.org/paper/a25e131813cb42e0809faed6204b8d39bf290978", "title": "Sketch-Plan-Generalize: Continual Few-Shot Learning of Inductively Generalizable Spatial Concepts for Language-Guided Robot Manipulation", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2404.07774?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2404.07774, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2149085911", "name": "Namasivayam Kalithasan"}, {"authorId": "2295988496", "n