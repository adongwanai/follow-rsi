{"offset": 1100, "data": [{"citingPaper": {"paperId": "c57dd7c0ca7bc137dc9c77c977b7d7265333f348", "externalIds": {"DBLP": "conf/wmt/JonHPB25", "DOI": "10.18653/v1/2025.wmt-1.44", "CorpusId": 282893780}, "url": "https://www.semanticscholar.org/paper/c57dd7c0ca7bc137dc9c77c977b7d7265333f348", "title": "CUNI at WMT25 General Translation Task", "openAccessPdf": {"url": "https://aclanthology.org/2025.wmt-1.44.pdf", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.18653/v1/2025.wmt-1.44?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.18653/v1/2025.wmt-1.44, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2265529525", "name": "J. Jon"}, {"authorId": "2331625014", "name": "Miroslav Hrabal"}, {"authorId": "3209310", "name": "M. Popel"}, {"authorId": "2301579359", "name": "Ond\u0159ej Bojar"}], "abstract": "This paper describes the CUNI submissions to the WMT25 General Translation task, namely for the English to Czech, English to Serbian, Czech to German and Czech to Ukrainian language pairs. We worked in multiple teams, each with a different approach, spanning from traditional, smaller Trans-former NMT models trained on both sentence and document level, to fine-tuning LLMs using LoRA and CPO. We show that these methods are effective in improving automatic MT evaluation scores compared to the base pretrained models"}}, {"citingPaper": {"paperId": "db954c988e337de2bd27bde3125745070b379037", "externalIds": {"DBLP": "journals/access/SindhuA25", "DOI": "10.1109/ACCESS.2025.3635613", "CorpusId": 283152603}, "url": "https://www.semanticscholar.org/paper/db954c988e337de2bd27bde3125745070b379037", "title": "Agent-Based Generative AI Model for Cost-Aware Automation in Machine Learning Pipelines", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2025.3635613", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2025.3635613?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2025.3635613, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "144329499", "name": "A. Sindhu"}, {"authorId": "145944544", "name": "S. Arumugam"}], "abstract": "The proposed agent-based generative AI model addresses the increasing requirement for cost-aware automation in machine learning pipelines. The traditional AutoML systems focus on performance metrics without considering the associated computational and financial costs. The model establishes an intelligent agent to track execution metrics and performance thresholds and resource utilization in real-time. The adaptive reasoning abilities of Generative AI enable the agent to suggest and activate suitable model configurations which match both task difficulty levels and financial limitations. The system performs real-time cost-performance trade-off analysis to optimize model selection and tuning processes. The system validates its performance through experimental testing on multiple datasets which demonstrates improved computational efficiency and resource management and financial efficiency without compromising performance. The approach supports sustainable AI development especially in enterprise and cloud-based environments. The combination of cost-awareness with adaptive intelligence creates a foundation for AutoML solutions that scale across different domains and workloads while remaining economically optimized."}}, {"citingPaper": {"paperId": "539047eb0b2800cdf2c62771f1683956efcb0efd", "externalIds": {"DOI": "10.18653/v1/2025.fever-1.8", "CorpusId": 280620241}, "url": "https://www.semanticscholar.org/paper/539047eb0b2800cdf2c62771f1683956efcb0efd", "title": "FACT5: A Novel Benchmark and Pipeline for Nuanced Fact-Checking of Complex Statements", "openAccessPdf": {"url": "https://aclanthology.org/2025.fever-1.8.pdf", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.18653/v1/2025.fever-1.8?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.18653/v1/2025.fever-1.8, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": null, "publicationDate": null, "authors": [{"authorId": "2375761283", "name": "Shayan Chowdhury"}, {"authorId": "2375724305", "name": "S. Fang"}, {"authorId": "2295928", "name": "S. Muresan"}], "abstract": ","}}, {"citingPaper": {"paperId": "1b0813b443bdfef2332b989a6aafe2f86364753a", "externalIds": {"DBLP": "journals/access/GhafariSRGLBLS25", "DOI": "10.1109/ACCESS.2025.3637226", "CorpusId": 283434620}, "url": "https://www.semanticscholar.org/paper/1b0813b443bdfef2332b989a6aafe2f86364753a", "title": "A Comprehensive Review on the Application of Large Language Models (LLMs) in Power Systems", "openAccessPdf": {"url": "https://doi.org/10.1109/access.2025.3637226", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/ACCESS.2025.3637226?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1109/ACCESS.2025.3637226, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2293464996", "name": "Masoumeh Ghafari"}, {"authorId": "2169866935", "name": "Asal Sami"}, {"authorId": "2377413801", "name": "Hamed Rezapour"}, {"authorId": "2183443611", "name": "Sepideh Saravani Ghayour"}, {"authorId": "92463101", "name": "Fan-Fan Lin"}, {"authorId": "9744602", "name": "K\u0131van\u00e7 Ba\u015faran"}, {"authorId": "9245969", "name": "G. L\u0103z\u0103roiu"}, {"authorId": "2217184169", "name": "P. Siano"}], "abstract": "Nowadays, modern power systems are facing increasing complexity with the rapid growth of renewable energy sources (RESs), the expansion of small and distributed energy resources (DERs) and the evolution towards cyber-physical smart grids. These developments have made the need for intelligent and flexible systems to support the decision-making processes. Advanced large linguistic models (LLM), as a new generation of artificial intelligence (AI), can understand and process complex text data and have been proposed as an innovative solution in the energy industry. These technologies can create a fundamental transformation in power systems management and optimization. This paper analyzes in depth the application of LLM in power systems. The current research tracks the evolution of AI in this field from simple methods, based on basic rules, to more advanced technologies, such as deep learning and transformer models. Within the paper, the basic principles of transformer models are described, and three important capabilities of this technology are emphasized: the ability to interpret the results, the ability to expand for different applications, and the flexibility to face different conditions. The conducted analysis highlights how the new generation of AI can bring a fundamental transformation in the management of power systems."}}, {"citingPaper": {"paperId": "070d4ab06b32abb285aa88c892d5955d4bb2ebe5", "externalIds": {"DBLP": "conf/emnlp/KimKJ25", "DOI": "10.18653/v1/2025.findings-emnlp.1022", "CorpusId": 282906668}, "url": "https://www.semanticscholar.org/paper/070d4ab06b32abb285aa88c892d5955d4bb2ebe5", "title": "UniRAG: A Unified RAG Framework for Knowledge-Intensive Queries with Decomposition, Break-Down Reasoning, and Iterative Rewriting", "openAccessPdf": {"url": "https://aclanthology.org/2025.findings-emnlp.1022.pdf", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.18653/v1/2025.findings-emnlp.1022?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.18653/v1/2025.findings-emnlp.1022, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2162828557", "name": "Gun Il Kim"}, {"authorId": "2145246865", "name": "Jong Wook Kim"}, {"authorId": "3235960", "name": "Beakcheol Jang"}], "abstract": ","}}, {"citingPaper": {"paperId": "1fad4aa33ab29d71c0c94f7f034519c89247748a", "externalIds": {"DBLP": "conf/emnlp/LiuZZZHGWW25", "DOI": "10.18653/v1/2025.findings-emnlp.1034", "CorpusId": 282900955}, "url": "https://www.semanticscholar.org/paper/1fad4aa33ab29d71c0c94f7f034519c89247748a", "title": "Divide, Optimize, Merge: Scalable Fine-Grained Generative Optimization for LLM Agents", "openAccessPdf": {"url": "https://aclanthology.org/2025.findings-emnlp.1034.pdf", "status": "BRONZE", "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.18653/v1/2025.findings-emnlp.1034?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.18653/v1/2025.findings-emnlp.1034, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2253854104", "name": "Jia-Le Liu"}, {"authorId": "2290663165", "name": "Yifan Zeng"}, {"authorId": "2116579935", "name": "Shao-Kun Zhang"}, {"authorId": "2359587660", "name": "Chi Zhang"}, {"authorId": "2223611976", "name": "Malte H\u00f8jmark-Bertelsen"}, {"authorId": "2336735380", "name": "Marie Normann Gadeberg"}, {"authorId": "2257095799", "name": "Hua-Zheng Wang"}, {"authorId": "2257162610", "name": "Qing-Yun Wu"}], "abstract": "LLM-based optimization has shown remarkable potential in improving agentic systems. However, the conventional approach of prompting LLM-based generative optimizer with the trajectories on the whole training dataset in a single pass becomes untenable as datasets grow, leading to context window overflow and degraded pattern recognition. To address these challenges, we propose Fine-grained Gener-ative Optimization (FGO), a scalable framework that divides large optimization tasks into manageable subsets, performs targeted optimizations, and systematically combines optimized components through progressive merging. Evaluation across ALFWorld, Logistic-sQA, and GAIA benchmarks demonstrates that FGO outperforms conventional approach by 1.6-8.6% while reducing average prompt token consumption by 56.3%. Our framework provides a practical solution for scaling up LLM-based generative optimization of increasingly sophisticated agentic systems. Further analysis demonstrates that FGO achieves the most consistent performance gain in all training dataset sizes, showcasing its scalability and efficiency."}}, {"citingPaper": {"paperId": "271d5096048806edfdc286f8201402c455f0a411", "externalIds": {"DBLP": "conf/inlg/YamazakiTNI25", "CorpusId": 284377335}, "url": "https://www.semanticscholar.org/paper/271d5096048806edfdc286f8201402c455f0a411", "title": "PRICoT: Principle Retrieval and Injection from Inference Successes and Failures for CoT Improvement", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2381990181", "name": "Yudai Yamazaki"}, {"authorId": "2265761423", "name": "Naoto Takeda"}, {"authorId": "2184251149", "name": "Yasutaka Nishimura"}, {"authorId": "2256156246", "name": "Kazushi Ikeda"}], "abstract": null}}, {"citingPaper": {"paperId": "cc8bee67e97f683ff66dc99685dd5204caf6dbb8", "externalIds": {"DBLP": "conf/acl/LeNLN25", "DOI": "10.18653/v1/2025.findings-acl.182", "CorpusId": 280034612}, "url": "https://www.semanticscholar.org/paper/cc8bee67e97f683ff66dc99685dd5204caf6dbb8", "title": "Massively Multilingual Instruction-Following Information Extraction", "openAccessPdf": {"url": "https://doi.org/10.18653/v1/2025.findings-acl.182", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.18653/v1/2025.findings-acl.182?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.18653/v1/2025.findings-acl.182, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2273954356", "name": "Thang Le"}, {"authorId": "2328026755", "name": "Huy Huu Nguyen"}, {"authorId": "1755919", "name": "A. L\u01b0u"}, {"authorId": "2290276061", "name": "Thien Huu Nguyen"}], "abstract": ","}}, {"citingPaper": {"paperId": "915ee638f70dd259af24c9cbb9d257e9df45e482", "externalIds": {"DBLP": "conf/nips/MaPS25", "DOI": "10.52202/085713-2122", "CorpusId": 288707350}, "url": "https://www.semanticscholar.org/paper/915ee638f70dd259af24c9cbb9d257e9df45e482", "title": "Revising and Falsifying Sparse Autoencoder Feature Explanations", "openAccessPdf": {"url": "", "status": "CLOSED", "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.52202/085713-2122?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.52202/085713-2122, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2374196841", "name": "George Ma"}, {"authorId": "1394086728", "name": "Samuel Pfrommer"}, {"authorId": "2363570697", "name": "Somayeh Sojoudi"}], "abstract": "Mechanistic interpretability research seeks to reverse-engineer large language models (LLMs) by uncovering the internal representations of concepts within their activations. Sparse Autoencoders (SAEs) have emerged as a valuable tool for disentangling polysemantic neurons into more monosemantic, interpretable features. However, recent work on automatic explanation generation for these features has faced challenges: explanations tend to be overly broad and fail to take polysemanticity into consideration. This work addresses these limitations by introducing a similarity-based strategy for sourcing close negative sentences that more effectively falsify generated explanations. Additionally, we propose a structured, component-based format for feature explanations and a tree-based, iterative explanation method that refines explanations. We demonstrate that our structured format and tree-based explainer improve explanation quality, while our similarity-based evaluation strategy exposes biases in existing interpretability methods. We also analyze the evolution of feature complexity and polysemanticity across LLM layers, offering new insights into information content within LLMs\u2019 residual streams. Code is available at https://github.com/GeorgeMLP/feature-interp ."}}, {"citingPaper": {"paperId": "058ddbb59946523f59e9eed9632e85148ed14b7e", "externalIds": {"DBLP": "journals/corr/abs-2508-04660", "DOI": "10.48550/arXiv.2508.04660", "CorpusId": 290087407}, "url": "https://www.semanticscholar.org/paper/058ddbb59946523f59e9eed9632e85148ed14b7e", "title": "Multi-module GRPO: Composing Policy Gradients and Prompt Optimization for Language Model Programs", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2508.04660?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2508.04660, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2264184691", "name": "Noah Ziems"}, {"authorId": "1914569491", "name": "Dilara Soylu"}, {"authorId": "2347536533", "name": "Lakshya A. Agrawal"}, {"authorId": "2086029456", "name": "Isaac Miller"}, {"authorId": "2347539758", "name": "Li-Heng Lai"}, {"authorId": "2449242716", "name": "Chen Qian"}, {"authorId": "2307070468", "name": "Kaiqiang Song"}, {"authorId": "2374356518", "name": "Meng Jiang"}, {"authorId": "2347540207", "name": "Dan Klein"}, {"authorId": "2257206424", "name": "Matei A. Zaharia"}, {"authorId": "2123124766", "name": "Karel D'Oosterlinck"}, {"authorId": "2254255092", "name": "Christopher Potts"}, {"authorId": "144112155", "name": "O. Khattab"}], "abstract": null}}, {"citingPaper": {"paperId": "6676f4fb59855a637b35c191e28a5900995a3a9c", "externalIds": {"DBLP": "journals/corr/abs-2510-18034", "DOI": "10.48550/arXiv.2510.18034", "CorpusId": 290964224}, "url": "https://www.semanticscholar.org/paper/6676f4fb59855a637b35c191e28a5900995a3a9c", "title": "SAVANT: Semantic Analysis with Vision-Augmented Anomaly deTection", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2510.18034?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2510.18034, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2367042980", "name": "Roberto Brusnicki"}, {"authorId": "48431247", "name": "David Pop"}, {"authorId": "2344057302", "name": "Yuan Gao"}, {"authorId": "2049096210", "name": "Mattia Piccinini"}, {"authorId": "2343748252", "name": "Johannes Betz"}], "abstract": null}}, {"citingPaper": {"paperId": "dc8254b46a4b8b7ae53fb1e405ca9d48befec216", "externalIds": {"DBLP": "journals/corr/abs-2511-20836", "DOI": "10.48550/arXiv.2511.20836", "CorpusId": 290975774}, "url": "https://www.semanticscholar.org/paper/dc8254b46a4b8b7ae53fb1e405ca9d48befec216", "title": "Structured Prompting Enables More Robust Evaluation of Language Models", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2511.20836?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2511.20836, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2240531495", "name": "Asad Aali"}, {"authorId": "2394310501", "name": "Muhammad Ahmed Mohsin"}, {"authorId": "86920013", "name": "V. Bikia"}, {"authorId": "2254255045", "name": "Arnav Singhvi"}, {"authorId": "2394310391", "name": "Richard Gaus"}, {"authorId": "2296770804", "name": "S. Bedi"}, {"authorId": "2345887883", "name": "He-Jie Cui"}, {"authorId": "2314513251", "name": "Miguel Fuentes"}, {"authorId": "2334020391", "name": "A. Unell"}, {"authorId": "2054708905", "name": "Yifan Mai"}, {"authorId": "2394310165", "name": "J. Cahoon"}, {"authorId": "2359204411", "name": "M. Pfeffer"}, {"authorId": "2301156881", "name": "Roxana Daneshjou"}, {"authorId": "143812875", "name": "O. Koyejo"}, {"authorId": "2268015621", "name": "E. Alsentzer"}, {"authorId": "2394310865", "name": "Christopher Potts"}, {"authorId": "2262093570", "name": "Nigam H. Shah"}, {"authorId": "2327186439", "name": "A. Chaudhari"}], "abstract": null}}, {"citingPaper": {"paperId": "657cbb38ba1220eb2fcc107c8d98bcec0c5c09c1", "externalIds": {"DBLP": "journals/corr/abs-2506-09046", "DOI": "10.48550/arXiv.2506.09046", "CorpusId": 291745068}, "url": "https://www.semanticscholar.org/paper/657cbb38ba1220eb2fcc107c8d98bcec0c5c09c1", "title": "Agentic Neural Networks: Self-Evolving Multi-Agent Systems via Textual Backpropagation", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2506.09046?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2506.09046, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "48577928", "name": "Xiao-Wen Ma"}, {"authorId": "2366255676", "name": "Chen-Yang Lin"}, {"authorId": "2324898389", "name": "Yao Zhang"}, {"authorId": "1742501819", "name": "Volker Tresp"}, {"authorId": "2375151391", "name": "Yun-Pu Ma"}], "abstract": null}}, {"citingPaper": {"paperId": "7ab6c834dd186a45b5f461ac1057a58c9f71b942", "externalIds": {"DBLP": "journals/corr/abs-2406-16218", "DOI": "10.48550/arXiv.2406.16218", "CorpusId": 276350345}, "url": "https://www.semanticscholar.org/paper/7ab6c834dd186a45b5f461ac1057a58c9f71b942", "title": "Trace is the New AutoDiff - Unlocking Efficient Optimization of Computational Workflows", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2406.16218?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2406.16218, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2262064790", "name": "Ching-An Cheng"}, {"authorId": "2253756381", "name": "Allen Nie"}, {"authorId": "40261572", "name": "Adith Swaminathan"}], "abstract": null}}, {"citingPaper": {"paperId": "c27a57d55480021d20b77477c69d9954746c2eb1", "externalIds": {"DBLP": "conf/acl-clinicalnlp/BannourAV24", "ACL": "2024.clinicalnlp-1.39", "DOI": "10.18653/v1/2024.clinicalnlp-1.39", "CorpusId": 270766212}, "url": "https://www.semanticscholar.org/paper/c27a57d55480021d20b77477c69d9954746c2eb1", "title": "Team NLPeers at Chemotimelines 2024: Evaluation of two timeline extraction methods, can generative LLM do it all or is smaller model fine-tuning still relevant ?", "openAccessPdf": {"url": "https://aclanthology.org/2024.clinicalnlp-1.39.pdf", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://aclanthology.org/2024.clinicalnlp-1.39, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "65849212", "name": "Nesrine Bannour"}, {"authorId": "2302559946", "name": "J. J. Andrew"}, {"authorId": "2308478045", "name": "Marc Vincent"}], "abstract": "This paper presents our two deep learning-based approaches to participate in subtask 1 of the Chemotimelines 2024 Shared task. The first uses a fine-tuning strategy on a relatively small general domain Masked Language Model (MLM) model, with additional normalization steps obtained using a simple Large Language Model (LLM) prompting technique. The second is an LLM-based approach combining advanced automated prompt search with few-shot in-context learning using the DSPy framework.Our results confirm the continued relevance of the smaller MLM fine-tuned model. It also suggests that the automated few-shot LLM approach can perform close to the fine-tuning-based method without extra LLM normalization and be advantageous under scarce data access conditions. We finally hint at the possibility to choose between lower training examples or lower computing resources requirements when considering both methods."}}, {"citingPaper": {"paperId": "22a9a4b3bc0760f30ad63fa0518d68895857cfc4", "externalIds": {"DBLP": "journals/corr/abs-2405-08965", "DOI": "10.48550/arXiv.2405.08965", "CorpusId": 269772931}, "url": "https://www.semanticscholar.org/paper/22a9a4b3bc0760f30ad63fa0518d68895857cfc4", "title": "LLMs are Meaning-Typed Code Constructs", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2405.08965?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2405.08965, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "144603405", "name": "Jason Mars"}, {"authorId": "2085723", "name": "Yiping Kang"}, {"authorId": "2267050177", "name": "Jayanaka L. Dantanarayana"}, {"authorId": "2276425331", "name": "Chandra Irugalbandara"}, {"authorId": "2301310519", "name": "Kugesan Sivasothynathan"}, {"authorId": "2235128", "name": "Ling-Jia Tang"}], "abstract": null}}, {"citingPaper": {"paperId": "3d51b9cf8d23fd038dac0ae7ade4fe27f1c03e9d", "externalIds": {"DBLP": "journals/corr/abs-2406-13629", "DOI": "10.48550/arXiv.2406.13629", "CorpusId": 270620428}, "url": "https://www.semanticscholar.org/paper/3d51b9cf8d23fd038dac0ae7ade4fe27f1c03e9d", "title": "InstructRAG: Instructing Retrieval-Augmented Generation with Explicit Denoising", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2406.13629?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2406.13629, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "122835755", "name": "Zhepei Wei"}, {"authorId": "2128184431", "name": "Wei-Lin Chen"}, {"authorId": "145391513", "name": "Yu Meng"}], "abstract": null}}, {"citingPaper": {"paperId": "06356e1821e8245996bb8a468a972a46571e7cdb", "externalIds": {"DBLP": "conf/acl-clinicalnlp/YaoHYGS24", "ACL": "2024.clinicalnlp-1.53", "DOI": "10.18653/v1/2024.clinicalnlp-1.53", "CorpusId": 270765481}, "url": "https://www.semanticscholar.org/paper/06356e1821e8245996bb8a468a972a46571e7cdb", "title": "Overview of the 2024 Shared Task on Chemotherapy Treatment Timeline Extraction", "openAccessPdf": {"url": "https://aclanthology.org/2024.clinicalnlp-1.53.pdf", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://aclanthology.org/2024.clinicalnlp-1.53, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2308634478", "name": "Jiarui Yao"}, {"authorId": "2215710664", "name": "H. Hochheiser"}, {"authorId": "51433082", "name": "WonJin Yoon"}, {"authorId": "2212987726", "name": "Eli Goldner"}, {"authorId": "1894531", "name": "G. Savova"}], "abstract": "The 2024 Shared Task on Chemotherapy Treatment Timeline Extraction aims to advance the state of the art of clinical event timeline extraction from the Electronic Health Records (EHRs). Specifically, this edition focuses on chemotherapy event timelines from EHRs of patients with breast, ovarian and skin cancers. These patient-level timelines present a novel challenge which involves tasks such as the extraction of relevant events, time expressions and temporal relations from each document and then summarizing over the documents. De-identified EHRs for 57,530 patients with breast and ovarian cancer spanning 2004-2020, and approximately 15,946 patients with melanoma spanning 2010-2020 were made available to participants after executing a Data Use Agreement. A subset of patients is annotated for gold entities, time expressions, temporal relations and patient-level timelines. The rest is considered unlabeled data. In Subtask1, gold chemotherapy event mentions and time expressions are provided (along with the EHR notes). Participants are asked to build the patient-level timelines using gold annotations as input. Thus, the subtask seeks to explore the topics of temporal relations extraction and timeline creation if event and time expression input is perfect. In Subtask2, which is the realistic real-world setting, only EHR notes are provided. Thus, the subtask aims at developing an end-to-end system for chemotherapy treatment timeline extraction from patient\u2019s EHR notes. There were 18 submissions for Subtask 1 and 9 submissions for Subtask 2. The organizers provided a baseline system. The teams employed a variety of methods including Logistic Regression, TF-IDF, n-grams, transformer models, zero-shot prompting with Large Language Models (LLMs), and instruction tuning. The gap in performance between prompting LLMs and finetuning smaller-sized LMs indicates that for a challenging task such as patient-level chemotherapy timeline extraction, more sophisticated LLMs or prompting techniques are necessary in order to achieve optimal results as finetuing smaller-sized LMs outperforms by a wide margin."}}, {"citingPaper": {"paperId": "c97f828a7e3bfdd443aaee491a24c2467a9b3d01", "externalIds": {"ACL": "2024.clinicalnlp-1.57", "DBLP": "conf/acl-clinicalnlp/AbachaYFSXY24", "DOI": "10.18653/v1/2024.clinicalnlp-1.57", "CorpusId": 270765494}, "url": "https://www.semanticscholar.org/paper/c97f828a7e3bfdd443aaee491a24c2467a9b3d01", "title": "Overview of the MEDIQA-CORR 2024 Shared Task on Medical Error Detection and Correction", "openAccessPdf": {"url": "https://aclanthology.org/2024.clinicalnlp-1.57.pdf", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://aclanthology.org/2024.clinicalnlp-1.57, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "1380176734", "name": "Asma Ben Abacha"}, {"authorId": "38845771", "name": "Wen-wai Yim"}, {"authorId": "2294828739", "name": "Yujuan Fu"}, {"authorId": "2308628212", "name": "Zhao-Yi Sun"}, {"authorId": "2294363357", "name": "Fei Xia"}, {"authorId": "50170368", "name": "M. Yeti\u015fgen"}], "abstract": "Automatic detection and correction of medical errors enables a more rigorous validation of medical documentation as well as clinical notes generated by large language models. Such solutions can ensure the accuracy and medical coherence of clinical texts and enhance patient care and health outcomes. The MEDIQA-CORR 2024 shared task focused on detecting and correcting different types of medical errors in clinical texts. Seventeen teams participated in the shared task and experimented with a broad range of approaches and models. In this paper, we describe the MEDIQA-CORR task, datasets, and the participants\u2019 results and methods."}}, {"citingPaper": {"paperId": "43f13ec417903c01637bb33070f2d69503ef70da", "externalIds": {"DBLP": "conf/iccbr/BrandMB24", "CorpusId": 270701562}, "url": "https://www.semanticscholar.org/paper/43f13ec417903c01637bb33070f2d69503ef70da", "title": "Large Language Models as Knowledge Engineers", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2140355341", "name": "F. Brand"}, {"authorId": "51250642", "name": "Lukas Malburg"}, {"authorId": "2308019575", "name": "Ralph Bergmann"}], "abstract": null}}, {"citingPaper": {"paperId": "0bf2808126242e36e4a7972522ba961a39beb8e5", "externalIds": {"DBLP": "journals/corr/abs-2404-11483", "DOI": "10.48550/arXiv.2404.11483", "CorpusId": 271645749}, "url": "https://www.semanticscholar.org/paper/0bf2808126242e36e4a7972522ba961a39beb8e5", "title": "AgentKit: Flow Engineering with Graphs, not Coding", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2404.11483?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2404.11483, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2253837062", "name": "Yue Wu"}, {"authorId": "2166103953", "name": "Ye-Wen Fan"}, {"authorId": "2008204295", "name": "So Yeon Min"}, {"authorId": "9358910", "name": "Shrimai Prabhumoye"}, {"authorId": "143953836", "name": "Stephen Mcaleer"}, {"authorId": "3312309", "name": "Yonatan Bisk"}, {"authorId": "2256996419", "name": "Ruslan Salakhutdinov"}, {"authorId": "2256011166", "name": "Yuan-Zhi Li"}, {"authorId": "2253469786", "name": "Tom M. Mitchell"}], "abstract": null}}, {"citingPaper": {"paperId": "167e84153ab4701d17d88fa0ff7bc452454f041a", "externalIds": {"ACL": "2024.langmol-1.9", "DOI": "10.18653/v1/2024.langmol-1.9", "CorpusId": 271769599}, "url": "https://www.semanticscholar.org/paper/167e84153ab4701d17d88fa0ff7bc452454f041a", "title": "Knowledge Graph Extraction from Total Synthesis Documents", "openAccessPdf": {"url": "https://aclanthology.org/2024.langmol-1.9.pdf", "status": "GOLD", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://aclanthology.org/2024.langmol-1.9, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": null, "publicationDate": null, "authors": [{"authorId": "2216007369", "name": "Andr\u00e9s M Bran"}, {"authorId": "98204416", "name": "Zlatko Joncev"}, {"authorId": "1379965853", "name": "P. Schwaller"}], "abstract": "Knowledge graphs (KGs) have emerged as a powerful tool for organizing and integrating complex information, making it a suitable format for scientific knowledge. However, translating scientific knowledge into KGs is challenging as a wide variety of styles and elements to present data and ideas is used. Although efforts for KG extraction (KGE) from scientific documents exist, evaluation remains challenging and field-dependent; and existing benchmarks do not focuse on scientific information. Furthermore, establishing a general benchmark for this task is challenging as not all scientific knowledge has a ground-truth KG representation, making any benchmark prone to ambiguity. Here we propose Graph of Organic Synthesis Benchmark (GOSyBench), a benchmark for KG extraction from scientific documents in chemistry, that leverages the native KG-like structure of synthetic routes in organic chemistry. We develop KG-extraction algorithms based on LLMs (GPT-4, Claude, Mistral) and VLMs (GPT-4o), the best of which reaches 73% recovery accuracy and 59% precision, leaving a lot of room for improvement. We expect GOSyBench can serve as a valuable resource for evaluating and advancing KGE methods in the scientific domain, ultimately facilitating better organization, integration, and discovery of scientific knowledge."}}, {"citingPaper": {"paperId": "33a946939210756ed15b50ef7f11c72577faad9d", "externalIds": {"ACL": "2024.wassa-1.16", "DBLP": "conf/wassa/SteelR24", "DOI": "10.18653/v1/2024.wassa-1.16", "CorpusId": 271769724}, "url": "https://www.semanticscholar.org/paper/33a946939210756ed15b50ef7f11c72577faad9d", "title": "Multi-Target User Stance Discovery on Reddit", "openAccessPdf": {"url": "https://aclanthology.org/2024.wassa-1.16.pdf", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://aclanthology.org/2024.wassa-1.16, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2202174562", "name": "Benjamin D. Steel"}, {"authorId": "2311760828", "name": "Derek Ruths"}], "abstract": "We consider how to credibly and reliably assess the opinions of individuals using their social media posts. To this end, this paper makes three contributions. First, we assemble a workflow and approach to applying modern natural language processing (NLP) methods to multi-target user stance detection in the wild. Second, we establish why the multi-target modeling of user stance is qualitatively more complicated than uni-target user-stance detection. Finally, we validate our method by showing how multi-dimensional measurement of user opinions not only reproduces known opinion polling results, but also enables the study of opinion dynamics at high levels of temporal and semantic resolution."}}, {"citingPaper": {"paperId": "34dff0c6beb01bb6eb53beb3d3ee80d9d81d52c0", "externalIds": {"DBLP": "journals/corr/abs-2410-15625", "DOI": "10.48550/arXiv.2410.15625", "CorpusId": 273502415}, "url": "https://www.semanticscholar.org/paper/34dff0c6beb01bb6eb53beb3d3ee80d9d81d52c0", "title": "Improving Parallel Program Performance Through DSL-Driven Code Generation with LLM Optimizers", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2410.15625?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2410.15625, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2028616391", "name": "Anjiang Wei"}, {"authorId": "2253756381", "name": "Allen Nie"}, {"authorId": "2326989082", "name": "Thiago S. F. X. Teixeira"}, {"authorId": "2069635284", "name": "Rohan Yadav"}, {"authorId": "2326962275", "name": "Wonchan Lee"}, {"authorId": "2327322280", "name": "Ke Wang"}, {"authorId": "2262454907", "name": "Alex Aiken"}], "abstract": null}}, {"citingPaper": {"paperId": "575d9b1905f7f73d36f842f1c543e3865bd3f6cb", "externalIds": {"DBLP": "journals/corr/abs-2410-21591", "DOI": "10.48550/arXiv.2410.21591", "CorpusId": 273661768}, "url": "https://www.semanticscholar.org/paper/575d9b1905f7f73d36f842f1c543e3865bd3f6cb", "title": "Can Large Language Models Replace Data Scientists in Clinical Research?", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.48550/arXiv.2410.21591?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.48550/arXiv.2410.21591, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2108733162", "name": "Zifeng Wang"}, {"authorId": "2227531018", "name": "Benjamin P. Danek"}, {"authorId": "2155486181", "name": "Zi-Wei Yang"}, {"authorId": "2343629943", "name": "Zheng Chen"}, {"authorId": "2504051310", "name": "Ji-Meng Sun"}], "abstract": null}}, {"citingPaper": {"paperId": "98f9cf4780e06f9e6b148becb7244d6e92933fc4", "externalIds": {"DBLP": "conf/chr/DalfsenKBMES24", "CorpusId": 274179514}, "url": "https://www.semanticscholar.org/paper/98f9cf4780e06f9e6b148becb7244d6e92933fc4", "title": "Direct and Indirect Annotation with Generative AI: A Case Study into Finding Animals and Plants in Historical Text", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2519767845", "name": "A. van Dalfsen"}, {"authorId": "2797989", "name": "Folgert Karsdorp"}, {"authorId": "2261403495", "name": "Ayoub Bagheri"}, {"authorId": "2331733970", "name": "Dieuwertje Mentink"}, {"authorId": "2485342617", "name": "T. van Engelen"}, {"authorId": "2331733864", "name": "E. Stronks"}], "abstract": null}}, {"citingPaper": {"paperId": "46480047afa9c10a20202ebf21c99a0fef5989bd", "externalIds": {"DBLP": "conf/overlay/BrunelloFGMMS24", "CorpusId": 275920476}, "url": "https://www.semanticscholar.org/paper/46480047afa9c10a20202ebf21c99a0fef5989bd", "title": "Evaluating LLMs Capabilities at Natural Language to Logic Translation: A Preliminary Investigation", "openAccessPdf": {"url": "", "status": null, "license": null}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "37833525", "name": "A. Brunello"}, {"authorId": "2342402627", "name": "Riccardo Ferrarese"}, {"authorId": "81293031", "name": "Luca Geatti"}, {"authorId": "2033515", "name": "Enrico Marzano"}, {"authorId": "2243064021", "name": "Angelo Montanari"}, {"authorId": "1885147205", "name": "N. Saccomanno"}], "abstract": null}}, {"citingPaper": {"paperId": "d2f8c8a763881cbacd6ee4103b2d441fac71420e", "externalIds": {"ACL": "2024.clicit-1.53", "DBLP": "conf/clic-it/KavasSW24", "CorpusId": 275357311}, "url": "https://www.semanticscholar.org/paper/d2f8c8a763881cbacd6ee4103b2d441fac71420e", "title": "Enhancing Job Posting Classification with Multilingual Embeddings and Large Language Models", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://aclanthology.org/2024.clicit-1.53, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "fieldsOfStudy": ["Computer Science"], "publicationDate": null, "authors": [{"authorId": "2313371895", "name": "Hamit Kavas"}, {"authorId": "2313372691", "name": "Marc Serra-Vidal"}, {"authorId": "2339009508", "name": "Leo Wanner"}], "abstract": null}}, {"citingPaper": {"paperId": "d9fbf374536d625667341ed8a2616cd698ee628b", "externalIds": {"DBLP": "journals/corr/abs-2405-16533", "DOI": "10.48550/arXiv.2405.16533", "CorpusId": 277244462}, "url": "https://www.semanticscholar.org/paper/d9fbf374536d625667341ed8a2616cd698ee628b", "title": "Chain of Tools: Large Language Model is an Automatic Multi-tool Learner", "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or a