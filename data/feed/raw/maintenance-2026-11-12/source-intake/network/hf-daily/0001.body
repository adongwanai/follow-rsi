[{"paper":{"id":"2610.39671","authors":[{"_id":"6af539145a190c5f859503a9","name":"Lingkai Kong","hidden":false},{"_id":"6af539145a190c5f859503aa","name":"Yuzhe Gu","hidden":false},{"_id":"6af539145a190c5f859503ab","name":"Haiteng Zhao","hidden":false},{"_id":"6af539145a190c5f859503ac","name":"Zijian Wu","hidden":false},{"_id":"6af539145a190c5f859503ad","name":"Youqing Fang","hidden":false},{"_id":"6af539145a190c5f859503ae","name":"Zhouqi Hua","hidden":false},{"_id":"6af539145a190c5f859503af","name":"Yanan Sun","hidden":false},{"_id":"6af539145a190c5f859503b0","name":"Kai Chen","hidden":false},{"_id":"6af539145a190c5f859503b1","name":"Wenwei Zhang","hidden":false}],"publishedAt":"2026-10-29T00:00:00.000Z","submittedOnDailyAt":"2026-11-12T00:00:00.000Z","title":"Incentivizing Self-Learning in Large Language Models via Reinforcement Learning","submittedOnDailyBy":{"_id":"6abb303fa26025a456cd7a3f","avatarUrl":"https://cdn-avatars.huggingface.co/v1/production/uploads/6abb303fa26025a456cd7a3f/ay4pWkZLf3xCgYDPBGd0E.png","isPro":false,"fullname":"Lingkai Kong","user":"debouter","type":"user","name":"debouter"},"summary":"Large language models (LLMs) draw on parametric knowledge and retrieval-augmented generation (RAG) to solve knowledge-intensive tasks. Yet problem solving in unfamiliar domains calls for tightly coupled knowledge acquisition and reasoning, beyond factual retrieval and aggregation or learning solely from a preassembled context. We study self-learning -- autonomously retrieving, studying, and applying knowledge from long-form reference materials on the fly. To investigate this capability, we formulate a textbook-based mathematical problem-solving task. LLMs must navigate textbook exposition, learn and apply relevant principles, and construct proofs for exercises, with reference solutions withheld. We introduce a BookNavigator interface to support this human-inspired study process and incentivize self-learning through reinforcement learning (RL) with fine-grained rewards. Experiments show that our method improves performance across in-domain and out-of-domain textbooks and subjects, raising Intern-S2-Preview-35B's overall proof accuracy from 51.5% to 79.5% and outperforming RL-trained textbook-free and fixed-retrieval baselines. These gains extend to complex long-context benchmarks involving different task types, with improvements over the base model of 1.7 and 2.3 percentage points on BrowseComp-Plus and CL-bench, respectively. Together, these findings suggest that RL can foster a domain-agnostic self-learning strategy, highlighting the potential of self-learning from long-form corpora to strengthen broader problem-solving capabilities on complex, long-context tasks.","upvotes":10,"discussionId":"6af539155a190c5f859503b2","organization":{"_id":"64a2d5fa81252883206f24c9","name":"internlm","fullname":"Intern Large Models","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/6432683407bad11484a68457/Q3Y0dL79GcsnaBCGRMooZ.png"}},"publishedAt":"2026-10-28T20:00:00.000Z","title":"Incentivizing Self-Learning in Large Language Models via Reinforcement Learning","summary":"Large language models (LLMs) draw on parametric knowledge and retrieval-augmented generation (RAG) to solve knowledge-intensive tasks. Yet problem solving in unfamiliar domains calls for tightly coupled knowledge acquisition and reasoning, beyond factual retrieval and aggregation or learning solely from a preassembled context. We study self-learning -- autonomously retrieving, studying, and applying knowledge from long-form reference materials on the fly. To investigate this capability, we formulate a textbook-based mathematical problem-solving task. LLMs must navigate textbook exposition, learn and apply relevant principles, and construct proofs for exercises, with reference solutions withheld. We introduce a BookNavigator interface to support this human-inspired study process and incentivize self-learning through reinforcement learning (RL) with fine-grained rewards. Experiments show that our method improves performance across in-domain and out-of-domain textbooks and subjects, raising Intern-S2-Preview-35B's overall proof accuracy from 51.5% to 79.5% and outperforming RL-trained textbook-free and fixed-retrieval baselines. These gains extend to complex long-context benchmarks involving different task types, with improvements over the base model of 1.7 and 2.3 percentage points on BrowseComp-Plus and CL-bench, respectively. Together, these findings suggest that RL can foster a domain-agnostic self-learning strategy, highlighting the potential of self-learning from long-form corpora to strengthen broader problem-solving capabilities on complex, long-context tasks.","thumbnail":"https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2610.39671.png","numComments":3,"submittedBy":{"_id":"6abb303fa26025a456cd7a3f","avatarUrl":"https://cdn-avatars.huggingface.co/v1/production/uploads/6abb303fa26025a456cd7a3f/ay4pWkZLf3xCgYDPBGd0E.png","fullname":"Lingkai Kong","name":"debouter","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"isUserFollowing":false},"organization":{"_id":"64a2d5fa81252883206f24c9","name":"internlm","fullname":"Intern Large Models","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/6432683407bad11484a68457/Q3Y0dL79GcsnaBCGRMooZ.png"},"isAuthorParticipating":false},{"paper":{"id":"2611.13028","authors":[{"_id":"6af3dad7dc6658cf91639662","user":{"_id":"6728aeb93a5bc303df90265f","avatarUrl":"/avatars/f2cd4624fc8a58891afed9938f852e27.svg","isPro":false,"fullname":"Jiajun Chen(SII)","user":"ljbro","type":"user","name":"ljbro"},"name":"Jiajun Chen","status":"claimed_verified","statusLastChangedAt":"2026-11-11T09:39:32.763Z","hidden":false},{"_id":"6af3dad7dc6658cf91639663","name":"Shicheng Fang","hidden":false},{"_id":"6af3dad7dc6658cf91639664","name":"Jiahao Lu","hidden":false},{"_id":"6af3dad7dc6658cf91639665","name":"Yuxin Wang","hidden":false},{"_id":"6af3dad7dc6658cf91639666","name":"Xipeng Qiu","hidden":false}],"publishedAt":"2026-11-09T00:00:00.000Z","submittedOnDailyAt":"2026-11-12T00:00:00.000Z","title":"GTAGym: Real AAA Game Tasks Environment for Evaluation and Reinforcement Learning","submittedOnDailyBy":{"_id":"6728aeb93a5bc303df90265f","avatarUrl":"/avatars/f2cd4624fc8a58891afed9938f852e27.svg","isPro":false,"fullname":"Jiajun Chen(SII)","user":"ljbro","type":"user","name":"ljbro"},"summary":"AAA games offer a rich testbed for evaluating agent perception, reasoning, and control. However, evaluating whether agents can complete tasks in AAA games is challenging and often human-annotated because task outcomes are often difficult to verify automatically, let alone applying it for Reinforcement Learning (RL). We introduce GTAGym, an environment and framework for evaluation and RL on GTA V tasks. Its evaluation benchmark, GTAVBench, derived from GTA V main-story missions, contains 103 online tasks reconstructed across nine task families, alongside 47 image-based shooting and sniping tasks using GTA V imagery. A web server provides access to the online environment and evaluation interface, supporting parallel testing through screenshots and keyboard-mouse actions with automatic engine-state outcome checks. We evaluate six frontier LLMs on GTAVBench with textual task instructions and on its GTAVBench-AGI branch, where instructions appear only in the first screenshot and a harness automatically compresses interaction history. The best configuration achieves 70.9% overall accuracy in GTAVBench-AGI, yet aerial navigation, evasion and interception remain difficult. GTAGym also provides a scalable generator that samples task parameters within user-specified ranges and option sets under fixed templates, creating batches of 3D and image-based shooting environments for RL with automatic reward and termination signals. LoRA RL of Qwen3.8-27B on generated on-foot navigation tasks improves the in-domain performance and transfers to out-of-domain task categories, and native GTA V tasks from 15% to 23%.","upvotes":8,"discussionId":"6af3dad7dc6658cf91639667","githubRepo":"https://github.com/ljbro/GTAGym","githubRepoAddedBy":"user","githubStars":1,"organization":{"_id":"613b0dee83ec35d460684607","name":"OpenMOSS-Team","fullname":"OpenMOSS","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/61457b8deff2c9fdb4de4988/N5b9663zQ4uq5_OTNlnmw.png"}},"publishedAt":"2026-11-08T19:00:00.000Z","title":"GTAGym: Real AAA Game Tasks Environment for Evaluation and Reinforcement Learning","summary":"AAA games offer a rich testbed for evaluating agent perception, reasoning, and control. However, evaluating whether agents can complete tasks in AAA games is challenging and often human-annotated because task outcomes are often difficult to verify automatically, let alone applying it for Reinforcement Learning (RL). We introduce GTAGym, an environment and framework for evaluation and RL on GTA V tasks. Its evaluation benchmark, GTAVBench, derived from GTA V main-story missions, contains 103 online tasks reconstructed across nine task families, alongside 47 image-based shooting and sniping tasks using GTA V imagery. A web server provides access to the online environment and evaluation interface, supporting parallel testing through screenshots and keyboard-mouse actions with automatic engine-state outcome checks. We evaluate six frontier LLMs on GTAVBench with textual task instructions and on its GTAVBench-AGI branch, where instructions appear only in the first screenshot and a harness automatically compresses interaction history. The best configuration achieves 70.9% overall accuracy in GTAVBench-AGI, yet aerial navigation, evasion and interception remain difficult. GTAGym also provides a scalable generator that samples task parameters within user-specified ranges and option sets under fixed templates, creating batches of 3D and image-based shooting environments for RL with automatic reward and termination signals. LoRA RL of Qwen3.8-27B on generated on-foot navigation tasks improves the in-domain performance and transfers to out-of-domain task categories, and native GTA V tasks from 15% to 23%.","thumbnail":"https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2611.13028.png","numComments":3,"submittedBy":{"_id":"6728aeb93a5bc303df90265f","avatarUrl":"/avatars/f2cd4624fc8a58891afed9938f852e27.svg","fullname":"Jiajun Chen(SII)","name":"ljbro","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"followerCount":2,"isUserFollowing":false},"organization":{"_id":"613b0dee83ec35d460684607","name":"OpenMOSS-Team","fullname":"OpenMOSS","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/61457b8deff2c9fdb4de4988/N5b9663zQ4uq5_OTNlnmw.png"},"isAuthorParticipating":true},{"paper":{"id":"2610.40394","authors":[{"_id":"6af536a35a190c5f8595039c","name":"Youqing Fang","hidden":false},{"_id":"6af536a35a190c5f8595039d","name":"Zhouqi Hua","hidden":false},{"_id":"6af536a35a190c5f8595039e","name":"Yinhao Tang","hidden":false},{"_id":"6af536a35a190c5f8595039f","name":"Yuzhe Gu","hidden":false},{"_id":"6af536a35a190c5f859503a0","name":"Lingkai Kong","hidden":false},{"_id":"6af536a35a190c5f859503a1","name":"Bin Liu","hidden":false},{"_id":"6af536a35a190c5f859503a2","name":"Weiming Zhang","hidden":false},{"_id":"6af536a35a190c5f859503a3","name":"Kai Chen","hidden":false},{"_id":"6af536a35a190c5f859503a4","name":"Yanan Sun","hidden":false},{"_id":"6af536a35a190c5f859503a5","name":"Wenwei Zhang","hidden":false}],"mediaUrls":["https://cdn-uploads.huggingface.co/production/uploads/6600f734997ede4f9b1bb33e/7qmWChOhrF4ry4Qyh5-dD.gif"],"publishedAt":"2026-10-29T00:00:00.000Z","submittedOnDailyAt":"2026-11-12T00:00:00.000Z","title":"Scaling Mathematical Proof Supervision from Structured Textbooks","submittedOnDailyBy":{"_id":"6600f734997ede4f9b1bb33e","avatarUrl":"https://cdn-avatars.huggingface.co/v1/production/uploads/6600f734997ede4f9b1bb33e/vvBsz6c1WUzAl9ifGSl_m.jpeg","isPro":false,"fullname":"Fang","user":"Youqing","type":"user","name":"Youqing"},"summary":"Mathematical supervision for language models is typically flattened into isolated problem-solution pairs, discarding the curricular organization and evidential structure of the original sources. We introduce TOME-Math (Textbook-Oriented Mathematical Evidence), a large-scale corpus that converts 2,118 textbooks spanning the core areas of university-level mathematics subjects into approximately 380K structured proof-supervision records while preserving chapter order, proposition-proof links, dependency references, and source provenance. Leveraging these structural signals, we explore curriculum learning across multiple mathematical subjects and characterize scaling patterns with supervision volume and source breadth. At full scale, fine-tuning on TOME-Math raises the unweighted mean score across our held-out evaluations and established public benchmarks by 16.7 percentage points over the base model, while exceeding all three public instruction-data baselines evaluated in aggregate. Our findings highlight structured textbooks as both a scalable source of mathematical supervision and an empirical framework for studying the impact of data organization on mathematical reasoning. We will release the corpus to facilitate further research on structured mathematical supervision.","upvotes":2,"discussionId":"6af536a35a190c5f859503a6","projectPage":"https://tome-math.github.io/","ai_summary":"A large-scale corpus of structured proof-supervision records derived from university mathematics textbooks improves language model mathematical reasoning by 16.7 percentage points over a base model when used for fine-tuning.","ai_keywords":["language models","fine-tuning","curriculum learning","scaling patterns","instruction-data baselines","mathematical reasoning"],"ai_summary_model":"deepseek-ai/DeepSeek-V4.1-Flash","organization":{"_id":"64a2d5fa81252883206f24c9","name":"internlm","fullname":"Intern Large Models","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/6432683407bad11484a68457/Q3Y0dL79GcsnaBCGRMooZ.png"}},"publishedAt":"2026-10-28T20:00:00.000Z","title":"Scaling Mathematical Proof Supervision from Structured Textbooks","summary":"Mathematical supervision for language models is typically flattened into isolated problem-solution pairs, discarding the curricular organization and evidential structure of the original sources. We introduce TOME-Math (Textbook-Oriented Mathematical Evidence), a large-scale corpus that converts 2,118 textbooks spanning the core areas of university-level mathematics subjects into approximately 380K structured proof-supervision records while preserving chapter order, proposition-proof links, dependency references, and source provenance. Leveraging these structural signals, we explore curriculum learning across multiple mathematical subjects and characterize scaling patterns with supervision volume and source breadth. At full scale, fine-tuning on TOME-Math raises the unweighted mean score across our held-out evaluations and established public benchmarks by 16.7 percentage points over the base model, while exceeding all three public instruction-data baselines evaluated in aggregate. Our findings highlight structured textbooks as both a scalable source of mathematical supervision and an empirical framework for studying the impact of data organization on mathematical reasoning. We will release the corpus to facilitate further research on structured mathematical supervision.","mediaUrls":["https://cdn-uploads.huggingface.co/production/uploads/6600f734997ede4f9b1bb33e/7qmWChOhrF4ry4Qyh5-dD.gif"],"thumbnail":"https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2610.40394.png","numComments":1,"submittedBy":{"_id":"6600f734997ede4f9b1bb33e","avatarUrl":"https://cdn-avatars.huggingface.co/v1/production/uploads/6600f734997ede4f9b1bb33e/vvBsz6c1WUzAl9ifGSl_m.jpeg","fullname":"Fang","name":"Youqing","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"isUserFollowing":false},"organization":{"_id":"64a2d5fa81252883206f24c9","name":"internlm","fullname":"Intern Large Models","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/6432683407bad11484a68457/Q3Y0dL79GcsnaBCGRMooZ.png"},"isAuthorParticipating":false},{"paper":{"id":"2607.24999","authors":[{"_id":"6ae955e44b63b3479c38a6be","user":{"_id":"659eb1b73a39bef2d2b7eca6","avatarUrl":"/avatars/897cd464db785aae3a0254926cd0b09a.svg","isPro":false,"fullname":"Dengzhe Hou","user":"dengzhe-hou","type":"user","name":"dengzhe-hou"},"name":"Dengzhe Hou","status":"claimed_verified","statusLastChangedAt":"2026-11-04T00:45:04.702Z","hidden":false},{"_id":"6ae955e44b63b3479c38a6bf","name":"Lingyu Jiang","hidden":false},{"_id":"6ae955e44b63b3479c38a6c0","name":"Fangzhou Lin","hidden":false},{"_id":"6ae955e44b63b3479c38a6c1","name":"Kazunori D Yamada","hidden":false}],"publishedAt":"2026-10-30T00:00:00.000Z","submittedOnDailyAt":"2026-11-12T00:00:00.000Z","title":"CogBattery: Human-Referenced Evaluation of Cognitive Task Behavior and Structure in Language Models","submittedOnDailyBy":{"_id":"659eb1b73a39bef2d2b7eca6","avatarUrl":"/avatars/897cd464db785aae3a0254926cd0b09a.svg","isPro":false,"fullname":"Dengzhe Hou","user":"dengzhe-hou","type":"user","name":"dengzhe-hou"},"summary":"Human cognitive tasks let us compare language models with humans under controlled conditions. Yet a model can reproduce the direction of a human effect while making different errors. CogBattery evaluates 54 open-weight language models on text adaptations of 13 cognitive paradigms, comparing each with human data from its source study. Like humans, models respond more to n-back lures than to controls, yet they make far more false alarms on ordinary non-targets. Most models' reported confidence separates correct from incorrect answers less well than humans' does, and most always choose the same wager, including models that classify accurately. These patterns span many model families. Across tasks, model scores share two dimensions. The first is closely tied to scale, yet larger models are not consistently closer to humans. Predefined cognitive groupings show no reliable predictive advantage over random groupings of the same size. These results show that matching human effect directions does not establish human-like behavior. CogBattery provides condition-level human references for testing errors and confidence reports in new models.","upvotes":1,"discussionId":"6ae955e44b63b3479c38a6c2","projectPage":"https://dengzhe-hou.github.io/CogBattery/","githubRepo":"https://github.com/dengzhe-hou/CogBattery","githubRepoAddedBy":"user","ai_summary":"CogBattery compares open-weight language models to humans across cognitive tasks, revealing that matching effect directions does not imply human-like error patterns or confidence calibration.","ai_keywords":["language models","n-back lures","false alarms","confidence calibration","cognitive paradigms","CogBattery","model scale","cognitive groupings"],"ai_summary_model":"thinkingmachines/Inkling-Small","githubStars":0},"publishedAt":"2026-10-29T20:00:00.000Z","title":"CogBattery: Human-Referenced Evaluation of Cognitive Task Behavior and Structure in Language Models","summary":"Human cognitive tasks let us compare language models with humans under controlled conditions. Yet a model can reproduce the direction of a human effect while making different errors. CogBattery evaluates 54 open-weight language models on text adaptations of 13 cognitive paradigms, comparing each with human data from its source study. Like humans, models respond more to n-back lures than to controls, yet they make far more false alarms on ordinary non-targets. Most models' reported confidence separates correct from incorrect answers less well than humans' does, and most always choose the same wager, including models that classify accurately. These patterns span many model families. Across tasks, model scores share two dimensions. The first is closely tied to scale, yet larger models are not consistently closer to humans. Predefined cognitive groupings show no reliable predictive advantage over random groupings of the same size. These results show that matching human effect directions does not establish human-like behavior. CogBattery provides condition-level human references for testing errors and confidence reports in new models.","thumbnail":"https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2607.24999.png","numComments":1,"submittedBy":{"_id":"659eb1b73a39bef2d2b7eca6","avatarUrl":"/avatars/897cd464db785aae3a0254926cd0b09a.svg","fullname":"Dengzhe Hou","name":"dengzhe-hou","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"isUserFollowing":false},"isAuthorParticipating":true},{"paper":{"id":"2611.10193","authors":[{"_id":"6af2d23e05af6789c0632a2a","user":{"_id":"662520d611e3eb621917ce3a","avatarUrl":"/avatars/1d391983e3ab3ea2a76ce8b2803f4cbd.svg","isPro":false,"fullname":"Saul Urso","user":"SaulUrso","type":"user","name":"SaulUrso"},"name":"Saul Urso","status":"claimed_verified","statusLastChangedAt":"2026-11-10T08:45:04.945Z","hidden":false},{"_id":"6af2d23e05af6789c0632a2b","name":"Emanuele Carlini","hidden":false},{"_id":"6af2d23e05af6789c0632a2c","name":"Patrizio Dazzi","hidden":false},{"_id":"6af2d23e05af6789c0632a2d","name":"Matteo Mordacchini","hidden":false}],"publishedAt":"2026-11-06T00:00:00.000Z","submittedOnDailyAt":"2026-11-12T00:00:00.000Z","title":"Ensemble Routing for Prompt-Adaptive Cost-Aware LLM Inference","submittedOnDailyBy":{"_id":"662520d611e3eb621917ce3a","avatarUrl":"/avatars/1d391983e3ab3ea2a76ce8b2803f4cbd.svg","isPro":false,"fullname":"Saul Urso","user":"SaulUrso","type":"user","name":"SaulUrso"},"summary":"Large language models (LLMs) increasingly support Web-based services that must balance response quality and inference cost across heterogeneous requests. Conventional routing selects one model per prompt, while fixed ensembles cannot adapt their composition and cost to individual requests. We introduce PISA, a prompt-adaptive, cost-aware single-model router, and PISA-E, its extension to ensemble routing. At the core of both methods, PISA combines soft cluster memberships with model-specific predictors to estimate individual model capabilities. Building on these estimates, PISA-E jointly selects ensemble composition and cardinality under an explicit cost--quality preference that can be adjusted at inference time without retraining. A tractable ensemble-success surrogate and efficient candidate selection enable this extension without ensemble-specific training. Across four LLM routing benchmarks under in-distribution (ID) and out-of-distribution (OOD) conditions, PISA achieves the highest macro-average cost--performance hypervolume among the evaluated single-model routers in both settings. Meanwhile, PISA-E achieves the highest macro-average task performance among the evaluated ensemble approaches when prioritizing response quality, surpassing the strongest competitors by 2.09 and 2.87 percentage points under ID and OOD conditions, respectively. At selected lower-cost operating points, it also exceeds the strongest ensemble competitors' macro-average task performance while reducing average inference cost by approximately 36% and 25%, respectively. These results demonstrate the effectiveness of prompt-adaptive capability estimation for both single-model routing and selective ensembling.","upvotes":1,"discussionId":"6af2d23e05af6789c0632a2e","ai_summary":"PISA and PISA-E use prompt-adaptive capability estimation to route prompts or select cost-aware ensembles, improving cost-performance trade-offs across LLM routing benchmarks.","ai_keywords":["large language models (LLMs)","prompt-adaptive routing","cost-aware single-model router","ensemble routing","soft cluster memberships","model-specific predictors","ensemble composition","ensemble cardinality","cost-quality preference","ensemble-success surrogate","candidate selection","in-distribution (ID)","out-of-distribution (OOD)","macro-average cost-performance hypervolume","single-model routers","ensemble approaches","inference cost"],"ai_summary_model":"deepseek-ai/DeepSeek-V4.1-Flash"},"publishedAt":"2026-11-05T19:00:00.000Z","title":"Ensemble Routing for Prompt-Adaptive Cost-Aware LLM Inference","summary":"Large language models (LLMs) increasingly support Web-based services that must balance response quality and inference cost across heterogeneous requests. Conventional routing selects one model per prompt, while fixed ensembles cannot adapt their composition and cost to individual requests. We introduce PISA, a prompt-adaptive, cost-aware single-model router, and PISA-E, its extension to ensemble routing. At the core of both methods, PISA combines soft cluster memberships with model-specific predictors to estimate individual model capabilities. Building on these estimates, PISA-E jointly selects ensemble composition and cardinality under an explicit cost--quality preference that can be adjusted at inference time without retraining. A tractable ensemble-success surrogate and efficient candidate selection enable this extension without ensemble-specific training. Across four LLM routing benchmarks under in-distribution (ID) and out-of-distribution (OOD) conditions, PISA achieves the highest macro-average cost--performance hypervolume among the evaluated single-model routers in both settings. Meanwhile, PISA-E achieves the highest macro-average task performance among the evaluated ensemble approaches when prioritizing response quality, surpassing the strongest competitors by 2.09 and 2.87 percentage points under ID and OOD conditions, respectively. At selected lower-cost operating points, it also exceeds the strongest ensemble competitors' macro-average task performance while reducing average inference cost by approximately 36% and 25%, respectively. These results demonstrate the effectiveness of prompt-adaptive capability estimation for both single-model routing and selective ensembling.","thumbnail":"https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2611.10193.png","numComments":1,"submittedBy":{"_id":"662520d611e3eb621917ce3a","avatarUrl":"/avatars/1d391983e3ab3ea2a76ce8b2803f4cbd.svg","fullname":"Saul Urso","name":"SaulUrso","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"followerCount":1,"isUserFollowing":false},"isAuthorParticipating":true},{"paper":{"id":"2603.27343","authors":[{"_id":"6a0ad1c53049bece374a85a9","user":{"_id":"659eb1b73a39bef2d2b7eca6","avatarUrl":"/avatars/897cd464db785aae3a0254926cd0b09a.svg","isPro":false,"fullname":"Dengzhe Hou","user":"dengzhe-hou","type":"user","name":"dengzhe-hou"},"name":"Dengzhe Hou","status":"claimed_verified","statusLastChangedAt":"2026-05-18T09:40:30.461Z","hidden":false},{"_id":"6a0ad1c53049bece374a85aa","name":"Lingyu Jiang","hidden":false},{"_id":"6a0ad1c53049bece374a85ab","name":"Deng Li","hidden":false},{"_id":"6a0ad1c53049bece374a85ac","name":"Zirui Li","hidden":false},{"_id":"6a0ad1c53049bece374a85ad","name":"Fangzhou Lin","hidden":false},{"_id":"6a0ad1c53049bece374a85ae","name":"Kazunori D Yamada","hidden":false}],"publishedAt":"2026-10-30T00:00:00.000Z","submittedOnDailyAt":"2026-11-12T00:00:00.000Z","title":"WMIP: A Working-Memory-Inspired Programmable Probe of Cumulative State Tracking in Large Language Models","submittedOnDailyBy":{"_id":"659eb1b73a39bef2d2b7eca6","avatarUrl":"/avatars/897cd464db785aae3a0254926cd0b09a.svg","isPro":false,"fullname":"Dengzhe Hou","user":"dengzhe-hou","type":"user","name":"dengzhe-hou"},"summary":"Human working memory lets people maintain and update information. Large language models (LLMs) face a related demand when tracking updates within a single prompt without writing out intermediate states, yet existing tests differ in their constraints on written steps. We introduce a working-memory-inspired probe of cumulative state tracking with program-computed answers, 3 to 100 updates, and final-state, intermediate-state, or multi-target queries. It compares protocols on identical items. Across 18 LLMs, accuracy is 84.9% on single-step arithmetic but 31.7% on core items requiring one number after three to seven updates. From 50 updates on, no model exceeds 10% accuracy. Core accuracy reaches 88.0% under a larger budget and instructions to write steps and place the answer on the last line, mainly due to the instruction changes rather than the budget. Core accuracy also correlates positively with public Berkeley Function Calling Leaderboard scores. These findings show that strong single-step arithmetic does not ensure reliable cumulative tracking and that output protocols substantially change measured accuracy. We release the generator, items, scoring code, and responses for reproducible comparisons across depths, query types, and protocols.","upvotes":0,"discussionId":"6a0ad1c53049bece374a85af","projectPage":"https://dengzhe-hou.github.io/WMIP/","githubRepo":"https://github.com/dengzhe-hou/WMIP","githubRepoAddedBy":"user","ai_summary":"Large language models struggle with cumulative state tracking across multiple updates despite strong single-step arithmetic, and their measured accuracy depends heavily on output protocols.","ai_keywords":["working memory","cumulative state tracking","large language models","multi-target queries","Berkeley Function Calling Leaderboard"],"ai_summary_model":"thinkingmachines/Inkling-Small","githubStars":1},"publishedAt":"2026-10-29T20:00:00.000Z","title":"WMIP: A Working-Memory-Inspired Programmable Probe of Cumulative State Tracking in Large Language Models","summary":"Human working memory lets people maintain and update information. Large language models (LLMs) face a related demand when tracking updates within a single prompt without writing out intermediate states, yet existing tests differ in their constraints on written steps. We introduce a working-memory-inspired probe of cumulative state tracking with program-computed answers, 3 to 100 updates, and final-state, intermediate-state, or multi-target queries. It compares protocols on identical items. Across 18 LLMs, accuracy is 84.9% on single-step arithmetic but 31.7% on core items requiring one number after three to seven updates. From 50 updates on, no model exceeds 10% accuracy. Core accuracy reaches 88.0% under a larger budget and instructions to write steps and place the answer on the last line, mainly due to the instruction changes rather than the budget. Core accuracy also correlates positively with public Berkeley Function Calling Leaderboard scores. These findings show that strong single-step arithmetic does not ensure reliable cumulative tracking and that output protocols substantially change measured accuracy. We release the generator, items, scoring code, and responses for reproducible comparisons across depths, query types, and protocols.","thumbnail":"https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2603.27343.png","numComments":1,"submittedBy":{"_id":"659eb1b73a39bef2d2b7eca6","avatarUrl":"/avatars/897cd464db785aae3a0254926cd0b09a.svg","fullname":"Dengzhe Hou","name":"dengzhe-hou","type":"user","isPro":false,"isHf":false,"isHfAdmin":false,"isMod":false,"isUserFollowing":false},"isAuthorParticipating":true}]